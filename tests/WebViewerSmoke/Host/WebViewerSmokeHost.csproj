<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
    <!-- The base SkiaSharp package only bundles native binaries for Windows/macOS.
         CI's playwright-smoke job runs on ubuntu-latest and needs libSkiaSharp.so,
         which lives in this separate package (confirmed missing without it: CI run
         33802825128 threw DllNotFoundException for libSkiaSharp.so on Linux). -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="2.88.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\PixelWizard.Transport.WebSocket\PixelWizard.Transport.WebSocket.csproj" />
  </ItemGroup>

</Project>
