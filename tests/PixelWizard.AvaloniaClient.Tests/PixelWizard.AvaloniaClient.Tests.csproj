<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <!--
    Same single TargetFramework per OS as PixelWizard.AvaloniaClient, so the reference
    always resolves: PixelWizard.Tests multi-targets net9.0;net9.0-windows and so can't
    reference the client on either OS (one of its two TFMs has no matching client build).
  -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <TargetFramework>net9.0-windows</TargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
    <TargetFramework>net9.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- Runs [AvaloniaFact] tests on a headless UI thread, so view models that use
         Dispatcher.UIThread can be exercised without a window or display. -->
    <PackageReference Include="Avalonia.Headless.XUnit" Version="11.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\avalonia\PixelWizard.AvaloniaClient\PixelWizard.AvaloniaClient.csproj" />
  </ItemGroup>
</Project>
