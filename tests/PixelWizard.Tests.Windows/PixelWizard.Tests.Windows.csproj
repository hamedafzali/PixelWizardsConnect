<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Windows-only counterpart to PixelWizard.Tests, isolated in its own project because
    PixelWizard.WindowsHost targets net9.0-windows (System.Drawing.Common / WinForms) and
    cannot be referenced from a net9.0 project (NU1201), and System.Drawing.Common does not
    run under .NET 9 on non-Windows regardless of TFM. This project therefore only
    builds/runs on Windows — it is exercised for real by T4's windows-latest CI job, not on
    the (macOS) machine these tests were authored on. See SkiaScreenChangeDetectorTests.cs
    in PixelWizard.Tests for the equivalent suite against the Mac/Linux detectors.
  -->
  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Allows cross-compiling (build-only, cannot run) this net9.0-windows project from macOS. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\PixelWizard.Core\PixelWizard.Core.csproj" />
    <ProjectReference Include="..\..\src\PixelWizard.WindowsHost\PixelWizard.WindowsHost.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\PixelWizard.Tests\Fixtures\ScreenChangeDetector\*.png"
          Link="Fixtures\ScreenChangeDetector\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
