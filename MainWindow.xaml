<Window x:Class="ScreenAutomationApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PixelWizard Connect"
        Height="560"
        Width="760"
        MinHeight="520"
        MinWidth="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#f4f6f8">
    <Window.Resources>
        <SolidColorBrush x:Key="InkBrush" Color="#16202a"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#667085"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#ffffff"/>
        <SolidColorBrush x:Key="LineBrush" Color="#d8dee8"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2563eb"/>
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#1d4ed8"/>
        <SolidColorBrush x:Key="SecondaryBrush" Color="#eef2f7"/>
        <SolidColorBrush x:Key="SecondaryHoverBrush" Color="#e2e8f0"/>

        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="SectionTitleText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="FieldLabelText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#475467"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource SecondaryBrush}"/>
            <Setter Property="Foreground" Value="#1f2937"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource SecondaryHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModeButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="58"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="18,12"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#344054"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinHeight" Value="38"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#111827"
                    CornerRadius="8"
                    Padding="22">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="PixelWizard Connect"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="White"/>
                        <TextBlock Text="Self-hosted remote support for controlled Windows MVP sessions."
                                   FontSize="13"
                                   Foreground="#cbd5e1"
                                   Margin="0,10,0,0"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom">
                        <Border Background="#1f2937"
                                BorderBrush="#334155"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="MVP Focus"
                                           Foreground="#e5e7eb"
                                           FontWeight="SemiBold"
                                           FontSize="13"/>
                                <TextBlock Text="Attended Windows-to-Windows sessions with a self-hosted router."
                                           Foreground="#aab4c1"
                                           FontSize="12"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Ready"
                                   Foreground="#94a3b8"
                                   FontSize="12"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,20">
                        <TextBlock Text="Remote Session"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource InkBrush}"/>
                        <TextBlock Text="Host this machine or connect to a remote host using a direct address or router code."
                                   FontSize="13"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,6,0,0"/>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <StackPanel x:Name="ModeSelectionPanel"
                                    VerticalAlignment="Top">
                            <TextBlock Text="Choose a mode"
                                       Style="{StaticResource SectionTitleText}"/>
                            <Button x:Name="RemoteModeButton"
                                    Content="Connect to remote desktop"
                                    Style="{StaticResource ModeButton}"
                                    Margin="0,0,0,10"
                                    Click="RemoteModeButton_Click"/>
                            <Button x:Name="ServerModeButton"
                                    Content="Host this computer"
                                    Style="{StaticResource ModeButton}"
                                    Click="ServerModeButton_Click"/>
                        </StackPanel>

                        <StackPanel x:Name="RemoteConnectionPanel"
                                    Visibility="Collapsed"
                                    VerticalAlignment="Top">
                            <Button x:Name="BackToModeButton"
                                    Content="Back"
                                    Style="{StaticResource SecondaryButton}"
                                    Width="88"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,18"
                                    Click="BackToModeButton_Click"/>

                            <TextBlock Text="Connection method"
                                       Style="{StaticResource SectionTitleText}"/>

                            <RadioButton x:Name="DirectIpRadioButton"
                                         Content="Direct IP connection"
                                         IsChecked="True"
                                         GroupName="ConnectionMethod"/>
                            <RadioButton x:Name="ConnectionCodeRadioButton"
                                         Content="Connection code via router"
                                         GroupName="ConnectionMethod"/>

                            <Separator Margin="0,18,0,18"/>

                            <StackPanel x:Name="DirectIpPanel">
                                <TextBlock Text="Host IP address"
                                           Style="{StaticResource FieldLabelText}"/>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             x:Name="DirectConnectIpTextBox"
                                             Text="127.0.0.1"/>
                                    <Button Grid.Column="2"
                                            x:Name="DirectConnectButton"
                                            Content="Connect"
                                            Width="112"
                                            Click="DirectConnectButton_Click"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel x:Name="ConnectionCodePanel"
                                        Visibility="Collapsed">
                                <TextBlock Text="Router server address"
                                           Style="{StaticResource FieldLabelText}"/>
                                <TextBox x:Name="RouterServerTextBox"
                                         Text="localhost:9000"
                                         Margin="0,0,0,16"/>

                                <TextBlock Text="Connection code"
                                           Style="{StaticResource FieldLabelText}"/>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             x:Name="ConnectionCodeTextBox"
                                             FontSize="14"/>
                                    <Button Grid.Column="2"
                                            x:Name="ConnectButton"
                                            Content="Connect"
                                            Width="112"
                                            Click="ConnectButton_Click"/>
                                </Grid>
                            </StackPanel>

                            <TextBlock x:Name="ClientStatusText"
                                       Text="Not connected"
                                       FontSize="13"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,8,0,0"/>
                        </StackPanel>

                        <StackPanel x:Name="ServerModePanel"
                                    Visibility="Collapsed"
                                    VerticalAlignment="Top">
                            <Button x:Name="BackToModeButton2"
                                    Content="Back"
                                    Style="{StaticResource SecondaryButton}"
                                    Width="88"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,18"
                                    Click="BackToModeButton_Click"/>

                            <TextBlock Text="Server type"
                                       Style="{StaticResource SectionTitleText}"/>

                            <RadioButton x:Name="DirectServerRadioButton"
                                         Content="Direct server without router"
                                         IsChecked="True"
                                         GroupName="ServerType"/>
                            <RadioButton x:Name="RouterServerRadioButton"
                                         Content="Router server with connection code"
                                         GroupName="ServerType"/>

                            <Separator Margin="0,18,0,18"/>

                            <TextBlock Text="Streaming quality"
                                       Style="{StaticResource FieldLabelText}"/>
                            <ComboBox x:Name="ServerQualityPresetComboBox"
                                      SelectedIndex="1"
                                      Width="180"
                                      HorizontalAlignment="Left"
                                      Margin="0,0,0,16"
                                      SelectionChanged="QualityPresetComboBox_SelectionChanged">
                                <ComboBoxItem Content="Low bandwidth"/>
                                <ComboBoxItem Content="Balanced"/>
                                <ComboBoxItem Content="High quality"/>
                                <ComboBoxItem Content="Fast"/>
                                <ComboBoxItem Content="Localhost"/>
                            </ComboBox>

                            <StackPanel x:Name="DirectServerPanel">
                                <TextBlock Text="Port"
                                           Style="{StaticResource FieldLabelText}"/>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             x:Name="DirectServerPortTextBox"
                                             Text="8888"/>
                                    <Button Grid.Column="2"
                                            x:Name="StartDirectServerButton"
                                            Content="Start server"
                                            Width="128"
                                            Click="StartDirectServerButton_Click"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel x:Name="RouterServerPanel"
                                        Visibility="Collapsed">
                                <TextBlock Text="Router server address"
                                           Style="{StaticResource FieldLabelText}"/>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             x:Name="RouterServerTextBox2"
                                             Text="localhost:9000"/>
                                    <Button Grid.Column="2"
                                            x:Name="RegisterWithRouterButton"
                                            Content="Register and start"
                                            Width="150"
                                            Click="RegisterWithRouterButton_Click"/>
                                </Grid>
                            </StackPanel>

                            <Border x:Name="ConnectionCodeDisplayPanel"
                                    Visibility="Collapsed"
                                    Background="#eff6ff"
                                    BorderBrush="#bfdbfe"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="16"
                                    Margin="0,8,0,16">
                                <StackPanel>
                                    <TextBlock Text="Connection code"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               Foreground="#1d4ed8"/>
                                    <TextBlock x:Name="ConnectionCodeText"
                                               Text="Not connected"
                                               FontSize="26"
                                               FontWeight="Bold"
                                               Foreground="#1e40af"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <TextBlock x:Name="ServerStatusText"
                                       Text="Server not started"
                                       FontSize="13"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,8,0,0"/>
                            <Button x:Name="StopSharingButton"
                                    Content="Stop sharing"
                                    Style="{StaticResource SecondaryButton}"
                                    Width="128"
                                    HorizontalAlignment="Left"
                                    Visibility="Collapsed"
                                    Margin="0,16,0,0"
                                    Click="StopSharingButton_Click"/>
                        </StackPanel>

                        <Border x:Name="ScreenDisplayPanel"
                                Visibility="Collapsed"
                                BorderBrush="#111827"
                                BorderThickness="1"
                                Background="#05070a"
                                CornerRadius="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                        Background="#111827"
                                        BorderBrush="#1f2937"
                                        BorderThickness="0,0,0,1"
                                        Padding="12,8">
                                    <DockPanel LastChildFill="False">
                                        <StackPanel Orientation="Horizontal"
                                                    DockPanel.Dock="Left">
                                            <TextBlock Text="Connected"
                                                       Foreground="#e5e7eb"
                                                       FontWeight="SemiBold"
                                                       FontSize="12"
                                                       Margin="0,0,16,0"/>
                                            <TextBlock x:Name="SignalQualityText"
                                                       Text="Signal: measuring"
                                                       Foreground="#cbd5e1"
                                                       FontSize="12"
                                                       Margin="0,0,16,0"/>
                                            <TextBlock x:Name="ViewerFpsText"
                                                       Text="FPS: 0"
                                                       Foreground="#cbd5e1"
                                                       FontSize="12"
                                                       Margin="0,0,16,0"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal"
                                                    DockPanel.Dock="Right">
                                            <ComboBox x:Name="ViewerQualityPresetComboBox"
                                                      SelectedIndex="1"
                                                      Width="130"
                                                      Margin="0,0,16,0"
                                                      SelectionChanged="QualityPresetComboBox_SelectionChanged">
                                                <ComboBoxItem Content="Low bandwidth"/>
                                                <ComboBoxItem Content="Balanced"/>
                                                <ComboBoxItem Content="High quality"/>
                                                <ComboBoxItem Content="Fast"/>
                                                <ComboBoxItem Content="Localhost"/>
                                            </ComboBox>
                                            <TextBlock x:Name="ViewerLatencyText"
                                                       Text="Latency: --"
                                                       Foreground="#cbd5e1"
                                                       FontSize="12"
                                                       Margin="0,0,16,0"/>
                                            <TextBlock x:Name="ViewerBandwidthText"
                                                       Text="Down: 0 KB/s"
                                                       Foreground="#cbd5e1"
                                                       FontSize="12"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Auto"
                                              Grid.Row="1">
                                    <Image x:Name="ScreenImage"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           MouseLeftButtonDown="ScreenImage_MouseLeftButtonDown"
                                           MouseRightButtonDown="ScreenImage_MouseRightButtonDown"/>
                                </ScrollViewer>

                                <Border x:Name="ConnectionOverlay"
                                        Grid.RowSpan="2"
                                        Background="#9905070a"
                                        Visibility="Collapsed">
                                    <StackPanel HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="Connected"
                                                   FontSize="22"
                                                   Foreground="White"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="RemoteInfoText"
                                                   FontSize="14"
                                                   Foreground="#d1d5db"
                                                   Margin="0,8,0,0"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <StatusBar Grid.Row="1"
                   Background="#ffffff"
                   BorderThickness="0,1,0,0"
                   BorderBrush="{StaticResource LineBrush}"
                   Padding="18,4">
            <StatusBarItem>
                <TextBlock x:Name="StatusText"
                           Text="Ready"
                           FontSize="12"
                           Foreground="{StaticResource MutedBrush}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
