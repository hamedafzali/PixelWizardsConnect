<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PixelWizard.AvaloniaClient.ViewModels"
        xmlns:views="using:PixelWizard.AvaloniaClient.Views"
        x:Class="PixelWizard.AvaloniaClient.Views.MainWindow"
        Title="{Binding WindowTitle}"
        Icon="/Assets/app-icon.png"
        Width="880" Height="620"
        MinWidth="720" MinHeight="540"
        Background="{StaticResource Brush.App.Bg}"
        FontFamily="{StaticResource Font.Sans}"
        x:DataType="vm:MainViewModel"
        KeyDown="OnKeyDown"
        KeyUp="OnKeyUp">

    <Grid RowDefinitions="*,32">

        <!-- ════ Main layout ════ -->
        <Grid Grid.Row="0" Margin="16" ColumnDefinitions="Auto,*">

            <!-- ══ Sidebar (collapsible while viewing) ══ -->
            <Border Grid.Column="0" Width="224" Margin="{StaticResource Space.Right.16}"
                    IsVisible="{Binding ShowSidebar}"
                    Background="{StaticResource Brush.Sidebar.Bg}" CornerRadius="12">
                <DockPanel Margin="20" LastChildFill="False">

                    <!-- Logo -->
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <Border Width="30" Height="30" Background="{StaticResource Brush.Primary}"
                                    CornerRadius="8" Margin="0,0,10,0">
                                <TextBlock Text="PW" FontSize="12" FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="PixelWizard"
                                       FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.Text.OnDark}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Connect" FontSize="11"
                                   Foreground="{StaticResource Brush.Text.OnDarkMuted}"
                                   Margin="40,0,0,12"/>
                    </StackPanel>

                    <!-- Footer -->
                    <StackPanel DockPanel.Dock="Bottom" Spacing="{StaticResource Space.8}">

                        <!-- Session stats when viewing -->
                        <Border Background="{StaticResource Brush.Sidebar.Surface}" CornerRadius="8"
                                Padding="{StaticResource Space.16x12}"
                                IsVisible="{Binding ShowScreenDisplay}">
                            <StackPanel Spacing="0">
                                <TextBlock Text="SESSION" FontSize="9" FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.Neutral.400}"
                                           Margin="{StaticResource Space.Bottom.10}"/>
                                <Grid ColumnDefinitions="*,Auto" Margin="{StaticResource Space.Bottom.8}">
                                    <TextBlock Grid.Column="0" Text="FPS"
                                               FontSize="12" Foreground="{StaticResource Brush.Text.OnDarkMuted}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Viewer.FpsText}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource Brush.Text.OnDark}"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" Margin="{StaticResource Space.Bottom.8}">
                                    <TextBlock Grid.Column="0" Text="Latency"
                                               FontSize="12" Foreground="{StaticResource Brush.Text.OnDarkMuted}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Viewer.LatencyText}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource Brush.Text.OnDark}"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Down"
                                               FontSize="12" Foreground="{StaticResource Brush.Text.OnDarkMuted}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Viewer.BandwidthText}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource Brush.Text.OnDark}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Keyboard badge -->
                        <Border Background="{StaticResource Brush.Badge.Keyboard.Bg}" CornerRadius="6" Padding="{StaticResource Space.10x7}"
                                IsVisible="{Binding Viewer.KeyboardActive}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.8}">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource Brush.Indicator.On}" VerticalAlignment="Center"/>
                                <TextBlock Text="Keyboard captured"
                                           FontSize="11" Foreground="{StaticResource Brush.Badge.Keyboard.Text}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- TLS badge -->
                        <Border Background="{StaticResource Brush.Sidebar.Surface}" CornerRadius="6" Padding="{StaticResource Space.10x7}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.8}">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource Brush.Indicator.On}" VerticalAlignment="Center"/>
                                <TextBlock Text="TLS encrypted"
                                           FontSize="11"
                                           Foreground="{StaticResource Brush.Text.OnDarkMuted}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="v0.1 · self-hosted" FontSize="10"
                                   Foreground="{StaticResource Brush.Neutral.500}"/>
                    </StackPanel>

                </DockPanel>
            </Border>

            <!-- ══ Right panel ══ -->
            <Border Grid.Column="1" Background="{StaticResource Brush.Surface}" CornerRadius="12"
                    BoxShadow="{StaticResource Shadow.Card}">
                <Grid>

                    <!-- ─── MODE SELECTION ─── -->
                    <views:ModeSelectionView IsVisible="{Binding ShowModeSelection}"/>

                    <!-- ─── VIEWER PANEL ─── -->
                    <ScrollViewer IsVisible="{Binding ShowViewerPanel}"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut"/>
                            </Transitions>
                        </ScrollViewer.Transitions>
                        <StackPanel Margin="{StaticResource Space.32x24}" Spacing="0" MaxWidth="520">

                            <DockPanel Margin="{StaticResource Space.Bottom.24}">
                                <Button Classes="Ghost" Content="← Back" Width="80" Height="32"
                                        DockPanel.Dock="Left" Command="{Binding BackCommand}"/>
                                <StackPanel Margin="{StaticResource Space.Left.16}" VerticalAlignment="Center">
                                    <TextBlock Text="Connect to Remote"
                                               FontSize="20" FontWeight="Bold"
                                               Foreground="{StaticResource Brush.Text.Primary}"/>
                                    <TextBlock Text="IP address or router connection code"
                                               FontSize="12"
                                               Foreground="{StaticResource Brush.Text.Muted}"
                                               Margin="{StaticResource Space.Top.4}"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- Loading indicator while connecting -->
                            <ProgressBar IsIndeterminate="True" Height="2"
                                         IsVisible="{Binding Viewer.IsConnecting}"
                                         Margin="{StaticResource Space.Bottom.8}"/>

                            <!-- Direct IP -->
                            <TextBlock Text="DIRECT IP" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.Text.Muted}"
                                       Margin="{StaticResource Space.Bottom.10}"/>

                            <!-- Recent hosts -->
                            <StackPanel IsVisible="{Binding Viewer.HasRecentHosts}" Margin="{StaticResource Space.Bottom.12}">
                                <TextBlock Text="Recent" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.Text.Secondary}"
                                           Margin="{StaticResource Space.Bottom.4}"/>
                                <ComboBox ItemsSource="{Binding Viewer.RecentHosts}"
                                          SelectedItem="{Binding Viewer.SelectedRecentHost}"
                                          HorizontalAlignment="Stretch"
                                          FontSize="13"
                                          IsEnabled="{Binding Viewer.InputEnabled}"
                                          ToolTip.Tip="Recently connected hosts"
                                          AutomationProperties.Name="Recent hosts"/>
                            </StackPanel>

                            <TextBlock Text="Host IP Address" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.Text.Secondary}"
                                       Margin="{StaticResource Space.Bottom.4}"/>
                            <Grid ColumnDefinitions="*,10,120" Margin="{StaticResource Space.Bottom.12}">
                                <TextBox Grid.Column="0" Text="{Binding Viewer.HostAddress}"
                                         Watermark="192.168.1.10" IsEnabled="{Binding Viewer.InputEnabled}"
                                         KeyDown="OnAddressKeyDown"
                                         AutomationProperties.Name="Remote host IP address"/>
                                <Button Grid.Column="2" Classes="Primary" Content="Connect"
                                        Command="{Binding Viewer.ConnectDirectCommand}"
                                        IsEnabled="{Binding Viewer.InputEnabled}"
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.Name="Connect via IP address"/>
                            </Grid>

                            <!-- Network discovery -->
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.8}" Margin="{StaticResource Space.Bottom.4}"
                                        IsVisible="{Binding !Viewer.IsConnecting}">
                                <Button Classes="Secondary" Content="Scan network"
                                        IsVisible="{Binding !Viewer.IsScanning}"
                                        Command="{Binding Viewer.ScanNetworkCommand}"
                                        AutomationProperties.Name="Scan local network"
                                        ToolTip.Tip="Scan local network for PixelWizard hosts (10 s)"/>
                                <Button Classes="Secondary" Content="Stop scan"
                                        IsVisible="{Binding Viewer.IsScanning}"
                                        Command="{Binding Viewer.ScanNetworkCommand}"
                                        AutomationProperties.Name="Stop scanning"/>
                                <TextBlock Text="{Binding Viewer.DiscoveredHosts.Count, StringFormat='{}{0} found'}"
                                           FontSize="12" Foreground="{StaticResource Brush.Text.Muted}"
                                           VerticalAlignment="Center"
                                           IsVisible="{Binding Viewer.IsScanning}"/>
                            </StackPanel>

                            <ListBox ItemsSource="{Binding Viewer.DiscoveredHosts}"
                                     IsVisible="{Binding Viewer.DiscoveredHosts.Count}"
                                     SelectedItem="{Binding Viewer.SelectedDiscoveredHost}"
                                     Margin="{StaticResource Space.Bottom.16}" MaxHeight="120"
                                     BorderBrush="{StaticResource Brush.Border}"
                                     BorderThickness="1" CornerRadius="8"
                                     FontSize="13"/>

                            <!-- Divider -->
                            <Grid ColumnDefinitions="*,Auto,*" Margin="{StaticResource Space.Bottom.28}">
                                <Separator Grid.Column="0" VerticalAlignment="Center"
                                           Background="{StaticResource Brush.Border}" Height="1"/>
                                <TextBlock Grid.Column="1" Text="  or via code  "
                                           FontSize="12"
                                           Foreground="{StaticResource Brush.Text.Muted}"
                                           VerticalAlignment="Center"/>
                                <Separator Grid.Column="2" VerticalAlignment="Center"
                                           Background="{StaticResource Brush.Border}" Height="1"/>
                            </Grid>

                            <!-- Router + Code -->
                            <TextBlock Text="VIA ROUTER" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.Text.Muted}"
                                       Margin="{StaticResource Space.Bottom.10}"/>
                            <TextBlock Text="Router Address" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.Text.Secondary}"
                                       Margin="{StaticResource Space.Bottom.4}"/>
                            <TextBox Text="{Binding Viewer.RouterAddress}"
                                     Watermark="router.example.com:9000"
                                     IsEnabled="{Binding Viewer.InputEnabled}"
                                     Margin="0,0,0,14"
                                     AutomationProperties.Name="Router address"/>
                            <TextBlock Text="Connection Code" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.Text.Secondary}"
                                       Margin="{StaticResource Space.Bottom.4}"/>
                            <Grid ColumnDefinitions="*,10,120" Margin="{StaticResource Space.Bottom.20}">
                                <TextBox Grid.Column="0" Text="{Binding Viewer.ConnectionCode}"
                                         Watermark="AB12CD" IsEnabled="{Binding Viewer.InputEnabled}"
                                         FontSize="18" FontWeight="SemiBold"
                                         KeyDown="OnCodeKeyDown"
                                         AutomationProperties.Name="Connection code"/>
                                <Button Grid.Column="2" Classes="Primary" Content="Connect"
                                        Command="{Binding Viewer.ConnectViaCodeCommand}"
                                        IsEnabled="{Binding Viewer.InputEnabled}"
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.Name="Connect via code"/>
                            </Grid>

                            <!-- Advanced expander with TLS -->
                            <Expander Header="Advanced" Margin="{StaticResource Space.Bottom.16}">
                                <CheckBox IsChecked="{Binding Viewer.UseTls}" Margin="{StaticResource Space.Top.8}">
                                    <TextBlock Text="Use TLS (recommended)" FontSize="12"
                                               Foreground="{StaticResource Brush.Text.Muted}"/>
                                </CheckBox>
                            </Expander>

                            <!-- Connecting status -->
                            <Border IsVisible="{Binding Viewer.IsConnecting}"
                                    Background="{StaticResource Brush.Info.Bg}" BorderBrush="{StaticResource Brush.Info.Border}"
                                    BorderThickness="1" CornerRadius="8" Padding="{StaticResource Space.16x12}">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.10}">
                                    <Ellipse Width="7" Height="7" Fill="{StaticResource Brush.Info}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Connecting…" FontSize="13" Foreground="{StaticResource Brush.Info.Text}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- ─── HOST PANEL ─── -->
                    <ScrollViewer IsVisible="{Binding ShowHostPanel}"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut"/>
                            </Transitions>
                        </ScrollViewer.Transitions>
                        <StackPanel Margin="{StaticResource Space.32x24}" Spacing="0" MaxWidth="520">

                            <DockPanel Margin="{StaticResource Space.Bottom.24}">
                                <Button Classes="Ghost" Content="← Back" Width="80" Height="32"
                                        DockPanel.Dock="Left" Command="{Binding BackCommand}"/>
                                <StackPanel Margin="{StaticResource Space.Left.16}" VerticalAlignment="Center">
                                    <TextBlock Text="Host This Computer"
                                               FontSize="20" FontWeight="Bold"
                                               Foreground="{StaticResource Brush.Text.Primary}"/>
                                    <TextBlock Text="Share your screen with an incoming viewer"
                                               FontSize="12"
                                               Foreground="{StaticResource Brush.Text.Muted}"
                                               Margin="{StaticResource Space.Top.4}"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- Feature 2: Monitor dropdown -->
                            <TextBlock Text="Monitor" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.Text.Secondary}"
                                       Margin="{StaticResource Space.Bottom.4}"/>
                            <ComboBox SelectedIndex="{Binding Host.SelectedMonitorIndex}"
                                      ItemsSource="{Binding Host.AvailableMonitors}"
                                      IsEnabled="{Binding !Host.IsHostRunning}"
                                      Width="300" Height="36" FontSize="12"
                                      Margin="{StaticResource Space.Bottom.16}"
                                      AutomationProperties.Name="Select monitor to share">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <!-- Method toggle -->
                            <Border Background="{StaticResource Brush.Segmented.Bg}" CornerRadius="9" Padding="3"
                                    Margin="{StaticResource Space.Bottom.20}" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <RadioButton Content="Direct" GroupName="HostMethod"
                                                 IsChecked="{Binding Host.ShowDirectHostPanel}"
                                                 Padding="{StaticResource Space.14x7}" CornerRadius="7"
                                                 FontSize="13" Cursor="Hand"/>
                                    <RadioButton Content="Via Router" GroupName="HostMethod"
                                                 IsChecked="{Binding Host.UseRouterForHost}"
                                                 Padding="{StaticResource Space.14x7}" CornerRadius="7"
                                                 FontSize="13" Cursor="Hand"/>
                                </StackPanel>
                            </Border>

                            <!-- Options row: quality + TLS -->
                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="{StaticResource Space.Bottom.20}">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="{StaticResource Space.10}">
                                    <TextBlock Text="Quality" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource Brush.Text.Secondary}"
                                               VerticalAlignment="Center"/>
                                    <ComboBox SelectedIndex="{Binding Host.HostQualityIndex}" Width="148"
                                              Height="36" FontSize="12"
                                              AutomationProperties.Name="Streaming quality">
                                        <ComboBoxItem Content="Low bandwidth"/>
                                        <ComboBoxItem Content="Balanced"/>
                                        <ComboBoxItem Content="High quality"/>
                                        <ComboBoxItem Content="Fast"/>
                                        <ComboBoxItem Content="Localhost"/>
                                    </ComboBox>
                                </StackPanel>
                                <CheckBox Grid.Column="2" IsChecked="{Binding Host.HostTlsEnabled}">
                                    <TextBlock Text="TLS" FontSize="12"
                                               Foreground="{StaticResource Brush.Text.Muted}"/>
                                </CheckBox>
                            </Grid>

                            <!-- Direct port form -->
                            <StackPanel IsVisible="{Binding Host.ShowDirectHostPanel}">
                                <TextBlock Text="Port" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.Text.Secondary}"
                                           Margin="{StaticResource Space.Bottom.4}"/>
                                <Grid ColumnDefinitions="110,10,Auto" Margin="0,0,0,0">
                                    <TextBox Grid.Column="0" Text="{Binding Host.HostPort}"
                                             IsEnabled="{Binding !Host.IsHostRunning}"/>
                                    <Button Grid.Column="2" Classes="Primary"
                                            Content="Start hosting" Width="140"
                                            Command="{Binding Host.StartDirectHostCommand}"
                                            IsEnabled="{Binding !Host.IsHostRunning}"/>
                                </Grid>
                            </StackPanel>

                            <!-- Router form -->
                            <StackPanel IsVisible="{Binding Host.ShowRouterHostPanel}">
                                <TextBlock Text="Router Address" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.Text.Secondary}"
                                           Margin="{StaticResource Space.Bottom.4}"/>
                                <Grid ColumnDefinitions="*,10,Auto">
                                    <TextBox Grid.Column="0" Text="{Binding Host.HostRouterAddress}"
                                             IsEnabled="{Binding !Host.IsHostRunning}"/>
                                    <Button Grid.Column="2" Classes="Primary"
                                            Content="Get connection code" Width="164"
                                            Command="{Binding Host.RegisterHostCommand}"
                                            IsEnabled="{Binding !Host.IsHostRunning}"/>
                                </Grid>
                            </StackPanel>

                            <!-- Connection code hero card -->
                            <Border IsVisible="{Binding Host.ShowCodeCard}"
                                    Background="{StaticResource Brush.Info.Bg}" BorderBrush="{StaticResource Brush.Info.Border}"
                                    BorderThickness="1" CornerRadius="10"
                                    Padding="20,16" Margin="0,20,0,0">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="SHARE THIS CODE"
                                                   FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Brush.Info}" Margin="{StaticResource Space.Bottom.4}"/>
                                        <TextBlock Text="{Binding Host.HostConnectionCode}"
                                                   FontSize="32" FontWeight="Bold"
                                                   Foreground="{StaticResource Brush.Info.TextStrong}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="Ghost"
                                            Content="Copy" Width="68" Height="34"
                                            FontSize="12" VerticalAlignment="Center"
                                            Command="{Binding Host.CopyCodeCommand}"/>
                                </Grid>
                            </Border>
                            <TextBlock Text="One-time use · Valid for 30 minutes · Share this code with your viewer"
                                       FontSize="11"
                                       Foreground="{StaticResource Brush.Text.Muted}"
                                       Margin="{StaticResource Space.Top.8}"
                                       IsVisible="{Binding Host.ShowCodeCard}"/>

                            <!-- Web viewer hint -->
                            <Border IsVisible="{Binding Host.ShowWebViewer}"
                                    Background="{StaticResource Brush.Success.Bg}" BorderBrush="{StaticResource Brush.Success.Border}"
                                    BorderThickness="1" CornerRadius="8"
                                    Padding="{StaticResource Space.16x8}" Margin="{StaticResource Space.Top.8}">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.8}">
                                    <TextBlock Text="{Binding Host.WebViewerUrl}"
                                               FontSize="12" Foreground="{StaticResource Brush.Success.Text}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Status row (no Stop button here — it's in the status bar) -->
                            <Grid ColumnDefinitions="Auto,*" Margin="0,14,0,0">
                                <Ellipse Grid.Column="0" Width="7" Height="7"
                                         Fill="{StaticResource Brush.Indicator.On}"
                                         VerticalAlignment="Center" Margin="{StaticResource Space.Right.8}"
                                         IsVisible="{Binding Host.IsHostRunning}"/>
                                <Ellipse Grid.Column="0" Width="7" Height="7"
                                         Fill="{StaticResource Brush.Indicator.Off}"
                                         VerticalAlignment="Center" Margin="{StaticResource Space.Right.8}"
                                         IsVisible="{Binding !Host.IsHostRunning}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Host.HostStatus}"
                                           FontSize="12"
                                           Foreground="{StaticResource Brush.Text.Muted}"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Feature 6: Session notes toggle (only while running) -->
                            <Button Classes="Ghost" Content="Session Notes"
                                    Height="30" FontSize="12"
                                    HorizontalAlignment="Left"
                                    Margin="0,12,0,0"
                                    IsVisible="{Binding Host.IsHostRunning}"
                                    Command="{Binding Host.ToggleSessionNotesCommand}"/>

                            <Border IsVisible="{Binding Host.SessionNotesVisible}"
                                    Background="{StaticResource Brush.Warning.Bg}"
                                    BorderBrush="{StaticResource Brush.Warning.Border}"
                                    BorderThickness="1" CornerRadius="8"
                                    Padding="12,10" Margin="{StaticResource Space.Top.4}">
                                <TextBox Text="{Binding Host.SessionNotes}"
                                         Watermark="Session notes (saved on disconnect)…"
                                         AcceptsReturn="True"
                                         Height="100"
                                         FontSize="12"
                                         TextWrapping="Wrap"
                                         AutomationProperties.Name="Session notes"/>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- ─── SCREEN DISPLAY ─── -->
                    <Grid IsVisible="{Binding ShowScreenDisplay}"
                          RowDefinitions="48,Auto,*,Auto">
                        <Grid.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut"/>
                            </Transitions>
                        </Grid.Transitions>

                        <!-- Toolbar -->
                        <Border Grid.Row="0" Background="{StaticResource Brush.Toolbar.Bg}"
                                CornerRadius="12,12,0,0" Padding="16,0">
                            <DockPanel VerticalAlignment="Center">
                                <!-- Left: live indicator + stats -->
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Spacing="16">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.8}">
                                        <Ellipse Width="7" Height="7" Fill="{StaticResource Brush.Indicator.On}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Live"
                                                   Foreground="{StaticResource Brush.Text.OnDark}"
                                                   FontWeight="SemiBold" FontSize="12"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Viewer.FpsText}"
                                               Foreground="{StaticResource Brush.Text.OnDarkMuted}"
                                               FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Viewer.LatencyText}"
                                               Foreground="{StaticResource Brush.Text.OnDarkMuted}"
                                               FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Viewer.BandwidthText}"
                                               Foreground="{StaticResource Brush.Text.OnDarkMuted}"
                                               FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock Text="⌨ Keyboard captured"
                                               IsVisible="{Binding Viewer.KeyboardActive}"
                                               Foreground="{StaticResource Brush.Badge.Keyboard.Text}"
                                               FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Right: [Quality] [Clipboard] [Chat] [Zoom ComboBox] [+] [−] [Disconnect] -->
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"
                                            Spacing="4" VerticalAlignment="Center">

                                    <!-- Sidebar toggle -->
                                    <Button Classes="Toolbar" Content="Panel"
                                            Command="{Binding ToggleSidebarCommand}" Width="48"
                                            ToolTip.Tip="Show or hide the side panel"
                                            AutomationProperties.Name="Toggle side panel"/>

                                    <!-- Feature 9: Quality preset ComboBox -->
                                    <ComboBox SelectedIndex="{Binding Viewer.ViewerQualityIndex}"
                                              Height="28" FontSize="11"
                                              Foreground="{StaticResource Brush.Toolbar.Text}" Background="{StaticResource Brush.Toolbar.Surface}"
                                              Width="84"
                                              VerticalAlignment="Center"
                                              ToolTip.Tip="Stream quality"
                                              AutomationProperties.Name="Stream quality">
                                        <ComboBoxItem Content="Low"/>
                                        <ComboBoxItem Content="Balanced"/>
                                        <ComboBoxItem Content="High"/>
                                        <ComboBoxItem Content="Fast"/>
                                    </ComboBox>

                                    <!-- Feature 1: Clipboard -->
                                    <Button Classes="Toolbar" Content="Clipboard"
                                            Command="{Binding Chat.SendClipboardCommand}" Width="70"
                                            ToolTip.Tip="Sync clipboard with host"
                                            AutomationProperties.Name="Sync clipboard with host"/>

                                    <!-- Feature 4: Chat toggle with unread badge -->
                                    <Panel>
                                        <Button Classes="Toolbar" Content="Chat"
                                                Command="{Binding Chat.ToggleCommand}" Width="44"
                                                ToolTip.Tip="Toggle chat panel"
                                                AutomationProperties.Name="Toggle chat panel"/>
                                        <Border Background="{StaticResource Brush.Badge.Unread}" CornerRadius="8"
                                                Padding="4,1"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Margin="0,-4,-4,0"
                                                IsVisible="{Binding Chat.HasUnread}">
                                            <TextBlock Text="{Binding Chat.UnreadCount}"
                                                       FontSize="9" Foreground="White"
                                                       FontWeight="Bold"/>
                                        </Border>
                                    </Panel>

                                    <!-- Zoom ComboBox -->
                                    <ComboBox SelectedIndex="{Binding Viewer.ZoomPresetIndex}"
                                              Height="28" Width="76" FontSize="11"
                                              Foreground="{StaticResource Brush.Toolbar.Text}" Background="{StaticResource Brush.Toolbar.Surface}"
                                              VerticalAlignment="Center"
                                              ToolTip.Tip="Zoom level"
                                              AutomationProperties.Name="Zoom level">
                                        <ComboBoxItem Content="Fit"/>
                                        <ComboBoxItem Content="50%"/>
                                        <ComboBoxItem Content="75%"/>
                                        <ComboBoxItem Content="100%"/>
                                        <ComboBoxItem Content="150%"/>
                                        <ComboBoxItem Content="200%"/>
                                    </ComboBox>

                                    <!-- Zoom In -->
                                    <Button Classes="Toolbar" Content="+"
                                            Command="{Binding Viewer.ZoomInCommand}" Width="28"
                                            ToolTip.Tip="Zoom in"
                                            AutomationProperties.Name="Zoom in"/>

                                    <!-- Zoom Out -->
                                    <Button Classes="Toolbar" Content="−"
                                            Command="{Binding Viewer.ZoomOutCommand}" Width="28"
                                            ToolTip.Tip="Zoom out"
                                            AutomationProperties.Name="Zoom out"/>

                                    <!-- Disconnect -->
                                    <Button Classes="Danger" Content="Disconnect"
                                            Command="{Binding Viewer.DisconnectCommand}"
                                            Height="28" FontSize="11" Padding="10,0"
                                            ToolTip.Tip="End session and disconnect"
                                            AutomationProperties.Name="Disconnect from session"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Feature 3: No-frames warning banner -->
                        <Border Grid.Row="1"
                                IsVisible="{Binding Viewer.ShowNoFramesBanner}"
                                Background="{StaticResource Brush.Warning.Bg}"
                                BorderBrush="{StaticResource Brush.Warning.Strong}"
                                BorderThickness="0,0,0,1" Padding="{StaticResource Space.16x8}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.8}">
                                <Path Width="16" Height="16" Stretch="Uniform"
                                      StrokeThickness="1.5" Stroke="{StaticResource Brush.Warning}" Fill="Transparent"
                                      Data="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"
                                      VerticalAlignment="Center"/>
                                <TextBlock Text="No frames received — check connection"
                                           FontSize="12" Foreground="{StaticResource Brush.Warning.Text}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Screen area -->
                        <Grid Grid.Row="2">
                            <!-- Fit mode -->
                            <Border IsVisible="{Binding Viewer.IsFitMode}" Background="{StaticResource Brush.Screen.Bg}">
                                <Grid>
                                    <Image x:Name="FitScreenImage" Stretch="Uniform"
                                           Source="{Binding Viewer.RemoteScreen}"
                                           HorizontalAlignment="Stretch"
                                           VerticalAlignment="Stretch"
                                           Cursor="Cross"
                                           PointerPressed="OnScreenPointerPressed"
                                           PointerReleased="OnScreenPointerReleased"
                                           PointerMoved="OnScreenPointerMoved"
                                           PointerEntered="OnScreenPointerEntered"
                                           PointerExited="OnScreenPointerExited"/>
                                    <!-- Empty state -->
                                    <StackPanel IsVisible="{Binding Viewer.RemoteScreen, Converter={x:Static ObjectConverters.IsNull}}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="Waiting for screen…" FontSize="13"
                                                   Foreground="{StaticResource Brush.Screen.EmptyText}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="The remote screen will appear here once the host starts streaming."
                                                   FontSize="11" Foreground="{StaticResource Brush.Screen.EmptySubtext}"
                                                   TextAlignment="Center" TextWrapping="Wrap"
                                                   MaxWidth="280" Margin="{StaticResource Space.Top.8}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Zoom mode -->
                            <ScrollViewer IsVisible="{Binding !Viewer.IsFitMode}"
                                          Background="{StaticResource Brush.Screen.Bg}"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto">
                                <Image x:Name="ZoomScreenImage" Source="{Binding Viewer.RemoteScreen}"
                                       Stretch="None"
                                       Width="{Binding Viewer.ScaledImageWidth}"
                                       Height="{Binding Viewer.ScaledImageHeight}"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"
                                       Cursor="Cross"
                                       PointerPressed="OnScreenPointerPressed"
                                       PointerReleased="OnScreenPointerReleased"
                                       PointerMoved="OnScreenPointerMoved"
                                       PointerEntered="OnScreenPointerEntered"
                                       PointerExited="OnScreenPointerExited"/>
                            </ScrollViewer>
                        </Grid>

                        <!-- Feature 4: Chat panel (overlay at bottom) -->
                        <Border Grid.Row="2"
                                IsVisible="{Binding Chat.Visible}"
                                Background="{StaticResource Brush.Chat.Overlay}"
                                BorderBrush="{StaticResource Brush.Chat.Border}"
                                BorderThickness="0,1,0,0"
                                MaxHeight="200"
                                VerticalAlignment="Bottom">
                            <Grid RowDefinitions="Auto,*,44">
                                <!-- Chat header with close button -->
                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto"
                                      Margin="12,6,12,4">
                                    <TextBlock Grid.Column="0" Text="Chat"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource Brush.Text.OnDarkMuted}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Classes="Toolbar" Content="✕"
                                            Width="22" Height="22" Padding="0"
                                            Command="{Binding Chat.ToggleCommand}"
                                            AutomationProperties.Name="Close chat panel"/>
                                </Grid>
                                <!-- Chat messages -->
                                <ScrollViewer Grid.Row="1"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Padding="12,4">
                                    <ItemsControl ItemsSource="{Binding Chat.Messages}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Display}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource Brush.Chat.Text}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,2"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <!-- Chat input -->
                                <Grid Grid.Row="2" ColumnDefinitions="*,80" Margin="8,4,8,8">
                                    <TextBox Grid.Column="0"
                                             Text="{Binding Chat.Input}"
                                             Watermark="Type a message…"
                                             Background="{StaticResource Brush.Chat.Input.Bg}"
                                             Foreground="{StaticResource Brush.Text.OnDark}"
                                             BorderBrush="{StaticResource Brush.Chat.Input.Border}"
                                             Height="36"
                                             FontSize="12"
                                             Margin="0,0,4,0"
                                             AutomationProperties.Name="Chat message"/>
                                    <Button Grid.Column="1" Classes="Primary"
                                            Content="Send"
                                            Height="36"
                                            Command="{Binding Chat.SendCommand}"
                                            AutomationProperties.Name="Send chat message"/>
                                </Grid>
                            </Grid>
                        </Border>

                    </Grid>

                </Grid>
            </Border>

        </Grid>

        <!-- ════ Status bar ════ -->
        <Border Grid.Row="1" Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0">
            <DockPanel Margin="24,0" VerticalAlignment="Center">
                <!-- Stop Hosting button — persistent, right side -->
                <Button DockPanel.Dock="Right" Classes="Danger" Content="Stop hosting"
                        Height="24" FontSize="11" Padding="12,0"
                        IsVisible="{Binding Host.IsHostRunning}"
                        Command="{Binding Host.StopHostCommand}"
                        AutomationProperties.Name="Stop hosting session"
                        Margin="0,0,0,0"/>
                <TextBlock DockPanel.Dock="Right"
                           Text="Hover screen to capture keyboard"
                           FontSize="11"
                           Foreground="{StaticResource Brush.Neutral.300}"
                           IsVisible="{Binding ShowScreenDisplay}"
                           VerticalAlignment="Center"
                           Margin="{StaticResource Space.Right.16}"/>
                <TextBlock Text="{Binding Status}"
                           FontSize="13"
                           Foreground="{StaticResource Brush.Text.Secondary}"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- ════ First-run onboarding overlay ════ -->
        <views:OnboardingOverlay Grid.Row="0" Grid.RowSpan="2" IsVisible="{Binding ShowOnboarding}"/>

    </Grid>
</Window>
