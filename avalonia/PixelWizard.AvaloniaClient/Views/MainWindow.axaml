<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PixelWizard.AvaloniaClient.ViewModels"
        x:Class="PixelWizard.AvaloniaClient.Views.MainWindow"
        Title="PixelWizard Connect"
        Width="880" Height="620"
        MinWidth="720" MinHeight="540"
        Background="#F0F4F8"
        x:DataType="vm:MainViewModel"
        KeyDown="OnKeyDown"
        KeyUp="OnKeyUp">

    <Window.Styles>
        <Style Selector="Button.primary">
            <Setter Property="Background"  Value="#2563EB"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Height"      Value="38"/>
            <Setter Property="FontSize"    Value="13"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1D4ED8"/>
        </Style>
        <Style Selector="Button.primary:disabled /template/ ContentPresenter">
            <Setter Property="Opacity" Value="0.4"/>
        </Style>

        <Style Selector="Button.ghost">
            <Setter Property="Background"         Value="Transparent"/>
            <Setter Property="Foreground"         Value="#6B7280"/>
            <Setter Property="BorderBrush"        Value="#E5E7EB"/>
            <Setter Property="BorderThickness"    Value="1"/>
            <Setter Property="CornerRadius"       Value="8"/>
            <Setter Property="FontSize"           Value="12"/>
            <Setter Property="Cursor"             Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#F9FAFB"/>
        </Style>

        <Style Selector="Button.danger">
            <Setter Property="Background"         Value="#FEF2F2"/>
            <Setter Property="Foreground"         Value="#EF4444"/>
            <Setter Property="BorderBrush"        Value="#FECACA"/>
            <Setter Property="BorderThickness"    Value="1"/>
            <Setter Property="CornerRadius"       Value="8"/>
            <Setter Property="FontSize"           Value="13"/>
            <Setter Property="FontWeight"         Value="SemiBold"/>
            <Setter Property="Cursor"             Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.toolbar-btn">
            <Setter Property="Background"  Value="#1E293B"/>
            <Setter Property="Foreground"  Value="#E2E8F0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Height"      Value="30"/>
            <Setter Property="FontSize"    Value="12"/>
            <Setter Property="Padding"     Value="12,0"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.toolbar-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#334155"/>
        </Style>

        <Style Selector="Button.card">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="BorderBrush"     Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="10"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
        </Style>
        <Style Selector="Button.card:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#FAFBFF"/>
        </Style>

        <Style Selector="TextBox">
            <Setter Property="Background"         Value="#F9FAFB"/>
            <Setter Property="BorderBrush"        Value="#E5E7EB"/>
            <Setter Property="BorderThickness"    Value="1"/>
            <Setter Property="CornerRadius"       Value="8"/>
            <Setter Property="Padding"            Value="10,0"/>
            <Setter Property="Height"             Value="38"/>
            <Setter Property="FontSize"           Value="13"/>
            <Setter Property="Foreground"         Value="#111827"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="#2563EB"/>
            <Setter Property="Background"  Value="White"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="*,32">

        <!-- ════ Main layout ════ -->
        <Grid Grid.Row="0" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="224"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ══ Sidebar ══ -->
            <Border Grid.Column="0" Background="#0F172A" CornerRadius="12">
                <DockPanel Margin="20" LastChildFill="False">

                    <!-- Logo -->
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <Border Width="30" Height="30" Background="#2563EB"
                                    CornerRadius="8" Margin="0,0,10,0">
                                <TextBlock Text="PW" FontSize="12" FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="PixelWizard"
                                       FontSize="15" FontWeight="SemiBold"
                                       Foreground="#F1F5F9" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Connect" FontSize="11"
                                   Foreground="#94A3B8" Margin="40,0,0,12"/>
                    </StackPanel>

                    <!-- Footer -->
                    <StackPanel DockPanel.Dock="Bottom" Spacing="8">

                        <!-- Session stats when viewing -->
                        <Border Background="#1E293B" CornerRadius="8" Padding="14,12"
                                IsVisible="{Binding ShowScreenDisplay}">
                            <StackPanel Spacing="0">
                                <TextBlock Text="SESSION" FontSize="9" FontWeight="SemiBold"
                                           Foreground="#475569" Margin="0,0,0,10"/>
                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                                    <TextBlock Grid.Column="0" Text="FPS"
                                               FontSize="12" Foreground="#94A3B8"/>
                                    <TextBlock Grid.Column="1" Text="{Binding FpsText}"
                                               FontSize="12" FontWeight="SemiBold" Foreground="#F1F5F9"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                                    <TextBlock Grid.Column="0" Text="Latency"
                                               FontSize="12" Foreground="#94A3B8"/>
                                    <TextBlock Grid.Column="1" Text="{Binding LatencyText}"
                                               FontSize="12" FontWeight="SemiBold" Foreground="#F1F5F9"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Down"
                                               FontSize="12" Foreground="#94A3B8"/>
                                    <TextBlock Grid.Column="1" Text="{Binding BandwidthText}"
                                               FontSize="12" FontWeight="SemiBold" Foreground="#F1F5F9"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Keyboard badge -->
                        <Border Background="#14532D" CornerRadius="6" Padding="10,7"
                                IsVisible="{Binding KeyboardActive}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Ellipse Width="6" Height="6" Fill="#10B981" VerticalAlignment="Center"/>
                                <TextBlock Text="Keyboard captured"
                                           FontSize="11" Foreground="#6EE7B7" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- TLS badge -->
                        <Border Background="#1E293B" CornerRadius="6" Padding="10,7">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Ellipse Width="6" Height="6" Fill="#10B981" VerticalAlignment="Center"/>
                                <TextBlock Text="TLS encrypted"
                                           FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="v0.1 · self-hosted" FontSize="10" Foreground="#334155"/>
                    </StackPanel>

                </DockPanel>
            </Border>

            <!-- ══ Right panel ══ -->
            <Border Grid.Column="2" Background="White" CornerRadius="12"
                    BoxShadow="0 0 0 1 #E5E7EB, 0 4 16 0 #18000000">
                <Grid>

                    <!-- ─── MODE SELECTION ─── -->
                    <StackPanel IsVisible="{Binding ShowModeSelection}"
                                VerticalAlignment="Center" Margin="40,0">

                        <TextBlock Text="Welcome" FontSize="26" FontWeight="Bold"
                                   Foreground="#111827" Margin="0,0,0,6"/>
                        <TextBlock Text="What would you like to do?"
                                   FontSize="14" Foreground="#6B7280" Margin="0,0,0,32"/>

                        <!-- HOST card -->
                        <Button Classes="card" Margin="0,0,0,12"
                                Command="{Binding GoHostCommand}"
                                IsEnabled="{Binding CanHost}">
                            <Grid Margin="20,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="44" Height="44"
                                        Background="#ECFDF5" CornerRadius="10"
                                        Margin="0,0,16,0">
                                    <TextBlock Text="📡" FontSize="20"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Host this computer"
                                               FontSize="15" FontWeight="SemiBold"
                                               Foreground="#111827"/>
                                    <TextBlock FontSize="12" Foreground="#6B7280" Margin="0,3,0,0">
                                        <TextBlock.Text>
                                            <Binding Path="CanHost"
                                                     StringFormat="{}Share your screen — {0:available on this device;host not available on this platform}"/>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="›" FontSize="20"
                                           Foreground="#D1D5DB" VerticalAlignment="Center"
                                           Margin="12,0,0,0"/>
                            </Grid>
                        </Button>

                        <!-- VIEWER card -->
                        <Button Classes="card" Command="{Binding GoViewerCommand}">
                            <Grid Margin="20,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="44" Height="44"
                                        Background="#EFF6FF" CornerRadius="10"
                                        Margin="0,0,16,0">
                                    <TextBlock Text="🖥" FontSize="20"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Connect to remote"
                                               FontSize="15" FontWeight="SemiBold"
                                               Foreground="#111827"/>
                                    <TextBlock Text="View and control another machine"
                                               FontSize="12" Foreground="#6B7280" Margin="0,3,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="›" FontSize="20"
                                           Foreground="#D1D5DB" VerticalAlignment="Center"
                                           Margin="12,0,0,0"/>
                            </Grid>
                        </Button>

                    </StackPanel>

                    <!-- ─── VIEWER PANEL ─── -->
                    <ScrollViewer IsVisible="{Binding ShowViewerPanel}"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="36,28" Spacing="0" MaxWidth="520">

                            <DockPanel Margin="0,0,0,24">
                                <Button Classes="ghost" Content="← Back" Width="80" Height="32"
                                        DockPanel.Dock="Left" Command="{Binding BackCommand}"/>
                                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Connect to Remote"
                                               FontSize="20" FontWeight="Bold" Foreground="#111827"/>
                                    <TextBlock Text="IP address or router connection code"
                                               FontSize="12" Foreground="#6B7280" Margin="0,3,0,0"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- Direct IP -->
                            <TextBlock Text="DIRECT IP" FontSize="10" FontWeight="SemiBold"
                                       Foreground="#9CA3AF" Margin="0,0,0,10"/>
                            <TextBlock Text="Host IP Address" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#374151" Margin="0,0,0,6"/>
                            <Grid ColumnDefinitions="*,10,120" Margin="0,0,0,28">
                                <TextBox Grid.Column="0" Text="{Binding HostAddress}"
                                         Watermark="192.168.1.10" IsEnabled="{Binding InputEnabled}"/>
                                <Button Grid.Column="2" Classes="primary" Content="Connect"
                                        Command="{Binding ConnectDirectCommand}"
                                        IsEnabled="{Binding InputEnabled}"
                                        HorizontalAlignment="Stretch"/>
                            </Grid>

                            <!-- Divider -->
                            <Grid ColumnDefinitions="*,Auto,*" Margin="0,0,0,28">
                                <Separator Grid.Column="0" VerticalAlignment="Center"
                                           Background="#E5E7EB" Height="1"/>
                                <TextBlock Grid.Column="1" Text="  or via code  "
                                           FontSize="12" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                                <Separator Grid.Column="2" VerticalAlignment="Center"
                                           Background="#E5E7EB" Height="1"/>
                            </Grid>

                            <!-- Router + Code -->
                            <TextBlock Text="VIA ROUTER" FontSize="10" FontWeight="SemiBold"
                                       Foreground="#9CA3AF" Margin="0,0,0,10"/>
                            <TextBlock Text="Router Address" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#374151" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding RouterAddress}" Watermark="localhost:9000"
                                     IsEnabled="{Binding InputEnabled}" Margin="0,0,0,14"/>
                            <TextBlock Text="Connection Code" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#374151" Margin="0,0,0,6"/>
                            <Grid ColumnDefinitions="*,10,120" Margin="0,0,0,20">
                                <TextBox Grid.Column="0" Text="{Binding ConnectionCode}"
                                         Watermark="AB12CD" IsEnabled="{Binding InputEnabled}"
                                         FontSize="18" FontWeight="SemiBold"/>
                                <Button Grid.Column="2" Classes="primary" Content="Connect"
                                        Command="{Binding ConnectViaCodeCommand}"
                                        IsEnabled="{Binding InputEnabled}"
                                        HorizontalAlignment="Stretch"/>
                            </Grid>

                            <CheckBox IsChecked="{Binding UseTls}" Margin="0,0,0,16">
                                <TextBlock Text="Use TLS (recommended)" FontSize="12" Foreground="#6B7280"/>
                            </CheckBox>

                            <Border IsVisible="{Binding IsConnecting}"
                                    Background="#EFF6FF" BorderBrush="#BFDBFE"
                                    BorderThickness="1" CornerRadius="8" Padding="14,11">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Ellipse Width="7" Height="7" Fill="#3B82F6" VerticalAlignment="Center"/>
                                    <TextBlock Text="Connecting…" FontSize="13" Foreground="#1D4ED8"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- ─── HOST PANEL ─── -->
                    <ScrollViewer IsVisible="{Binding ShowHostPanel}"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="36,28" Spacing="0" MaxWidth="520">

                            <DockPanel Margin="0,0,0,24">
                                <Button Classes="ghost" Content="← Back" Width="80" Height="32"
                                        DockPanel.Dock="Left" Command="{Binding BackCommand}"/>
                                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Host This Computer"
                                               FontSize="20" FontWeight="Bold" Foreground="#111827"/>
                                    <TextBlock Text="Share your screen with an incoming viewer"
                                               FontSize="12" Foreground="#6B7280" Margin="0,3,0,0"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- Method toggle -->
                            <Border Background="#F3F4F6" CornerRadius="9" Padding="3"
                                    Margin="0,0,0,20" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <RadioButton Content="Direct" GroupName="HostMethod"
                                                 IsChecked="{Binding ShowDirectHostPanel}"
                                                 Padding="14,7" CornerRadius="7"
                                                 FontSize="13" Cursor="Hand"/>
                                    <RadioButton Content="Via Router" GroupName="HostMethod"
                                                 IsChecked="{Binding UseRouterForHost}"
                                                 Padding="14,7" CornerRadius="7"
                                                 FontSize="13" Cursor="Hand"/>
                                </StackPanel>
                            </Border>

                            <!-- Options row: quality + TLS -->
                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,20">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="Quality" FontSize="12" FontWeight="SemiBold"
                                               Foreground="#374151" VerticalAlignment="Center"/>
                                    <ComboBox SelectedIndex="{Binding HostQualityIndex}" Width="148"
                                              Height="36" FontSize="12">
                                        <ComboBoxItem Content="Low bandwidth"/>
                                        <ComboBoxItem Content="Balanced"/>
                                        <ComboBoxItem Content="High quality"/>
                                        <ComboBoxItem Content="Fast"/>
                                        <ComboBoxItem Content="Localhost"/>
                                    </ComboBox>
                                </StackPanel>
                                <CheckBox Grid.Column="2" IsChecked="{Binding HostTlsEnabled}">
                                    <TextBlock Text="TLS" FontSize="12" Foreground="#6B7280"/>
                                </CheckBox>
                            </Grid>

                            <!-- Direct port form -->
                            <StackPanel IsVisible="{Binding ShowDirectHostPanel}">
                                <TextBlock Text="Port" FontSize="12" FontWeight="SemiBold"
                                           Foreground="#374151" Margin="0,0,0,6"/>
                                <Grid ColumnDefinitions="110,10,Auto" Margin="0,0,0,0">
                                    <TextBox Grid.Column="0" Text="{Binding HostPort}"
                                             IsEnabled="{Binding !IsHostRunning}"/>
                                    <Button Grid.Column="2" Classes="primary"
                                            Content="Start hosting" Width="140"
                                            Command="{Binding StartDirectHostCommand}"
                                            IsEnabled="{Binding !IsHostRunning}"/>
                                </Grid>
                            </StackPanel>

                            <!-- Router form -->
                            <StackPanel IsVisible="{Binding ShowRouterHostPanel}">
                                <TextBlock Text="Router Address" FontSize="12" FontWeight="SemiBold"
                                           Foreground="#374151" Margin="0,0,0,6"/>
                                <Grid ColumnDefinitions="*,10,Auto">
                                    <TextBox Grid.Column="0" Text="{Binding HostRouterAddress}"
                                             IsEnabled="{Binding !IsHostRunning}"/>
                                    <Button Grid.Column="2" Classes="primary"
                                            Content="Register &amp; start" Width="148"
                                            Command="{Binding RegisterHostCommand}"
                                            IsEnabled="{Binding !IsHostRunning}"/>
                                </Grid>
                            </StackPanel>

                            <!-- Connection code hero card -->
                            <Border IsVisible="{Binding ShowCodeCard}"
                                    Background="#EFF6FF" BorderBrush="#BFDBFE"
                                    BorderThickness="1" CornerRadius="10"
                                    Padding="20,16" Margin="0,20,0,0">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="SHARE THIS CODE"
                                                   FontSize="10" FontWeight="SemiBold"
                                                   Foreground="#3B82F6" Margin="0,0,0,6"/>
                                        <TextBlock Text="{Binding HostConnectionCode}"
                                                   FontSize="32" FontWeight="Bold"
                                                   Foreground="#1E40AF"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="ghost"
                                            Content="Copy" Width="68" Height="34"
                                            FontSize="12" VerticalAlignment="Center"
                                            Command="{Binding CopyCodeCommand}"/>
                                </Grid>
                            </Border>

                            <!-- Web viewer hint -->
                            <Border IsVisible="{Binding ShowWebViewer}"
                                    Background="#ECFDF5" BorderBrush="#A7F3D0"
                                    BorderThickness="1" CornerRadius="8"
                                    Padding="14,10" Margin="0,8,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="🌐" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding WebViewerUrl}"
                                               FontSize="12" Foreground="#065F46"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Status + stop -->
                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,14,0,0">
                                <Ellipse Grid.Column="0" Width="7" Height="7"
                                         Fill="#10B981"
                                         VerticalAlignment="Center" Margin="0,0,8,0"
                                         IsVisible="{Binding IsHostRunning}"/>
                                <Ellipse Grid.Column="0" Width="7" Height="7"
                                         Fill="#D1D5DB"
                                         VerticalAlignment="Center" Margin="0,0,8,0"
                                         IsVisible="{Binding !IsHostRunning}"/>
                                <TextBlock Grid.Column="1" Text="{Binding HostStatus}"
                                           FontSize="12" Foreground="#6B7280"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="2" Classes="danger"
                                        Content="Stop" Width="72" Height="32"
                                        FontSize="12"
                                        IsVisible="{Binding IsHostRunning}"
                                        Command="{Binding StopHostCommand}"/>
                            </Grid>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- ─── SCREEN DISPLAY ─── -->
                    <Grid IsVisible="{Binding ShowScreenDisplay}"
                          RowDefinitions="48,*">

                        <Border Grid.Row="0" Background="#0F172A"
                                CornerRadius="12,12,0,0" Padding="16,0">
                            <DockPanel VerticalAlignment="Center">
                                <!-- Left: live indicator + stats -->
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Spacing="16">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <Ellipse Width="7" Height="7" Fill="#10B981" VerticalAlignment="Center"/>
                                        <TextBlock Text="Live" Foreground="#F1F5F9"
                                                   FontWeight="SemiBold" FontSize="12"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding FpsText}"
                                               Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding LatencyText}"
                                               Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding BandwidthText}"
                                               Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                                <!-- Right: zoom controls + disconnect -->
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"
                                            Spacing="4" VerticalAlignment="Center">
                                    <Button Classes="toolbar-btn" Content="Fit"
                                            Command="{Binding FitWindowCommand}" Width="36"/>
                                    <Button Classes="toolbar-btn" Content="50%"
                                            Command="{Binding Zoom50Command}"  Width="40"/>
                                    <Button Classes="toolbar-btn" Content="75%"
                                            Command="{Binding Zoom75Command}"  Width="40"/>
                                    <Button Classes="toolbar-btn" Content="100%"
                                            Command="{Binding Zoom100Command}" Width="44"/>
                                    <Button Classes="toolbar-btn" Content="+"
                                            Command="{Binding ZoomInCommand}"  Width="30"/>
                                    <Button Classes="toolbar-btn" Content="−"
                                            Command="{Binding ZoomOutCommand}" Width="30"/>
                                    <TextBlock Text="{Binding ZoomLabel}"
                                               Foreground="#64748B" FontSize="11"
                                               VerticalAlignment="Center" Margin="4,0,8,0" MinWidth="32"/>
                                    <Button Classes="toolbar-btn" Content="Disconnect"
                                            Command="{Binding DisconnectCommand}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Fit mode: Image fills the panel and Stretch=Uniform scales it down.
                             The Image must NOT be inside a ScrollViewer here — ScrollViewer gives
                             infinite space and prevents Stretch=Uniform from shrinking the image. -->
                        <Border Grid.Row="1" IsVisible="{Binding IsFitMode}" Background="#020617">
                            <Image Stretch="Uniform"
                                   Source="{Binding RemoteScreen}"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch"
                                   Cursor="Cross"
                                   PointerPressed="OnScreenPointerPressed"
                                   PointerMoved="OnScreenPointerMoved"
                                   PointerEntered="OnScreenPointerEntered"
                                   PointerExited="OnScreenPointerExited"/>
                        </Border>

                        <!-- Zoom mode: explicit pixel dimensions + scrollbars -->
                        <ScrollViewer Grid.Row="1"
                                      IsVisible="{Binding !IsFitMode}"
                                      Background="#020617"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">
                            <Image Source="{Binding RemoteScreen}"
                                   Stretch="None"
                                   Width="{Binding ScaledImageWidth}"
                                   Height="{Binding ScaledImageHeight}"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top"
                                   Cursor="Cross"
                                   PointerPressed="OnScreenPointerPressed"
                                   PointerMoved="OnScreenPointerMoved"
                                   PointerEntered="OnScreenPointerEntered"
                                   PointerExited="OnScreenPointerExited"/>
                        </ScrollViewer>

                    </Grid>

                </Grid>
            </Border>

        </Grid>

        <!-- ════ Status bar ════ -->
        <Border Grid.Row="1" Background="White"
                BorderBrush="#E5E7EB" BorderThickness="0,1,0,0">
            <DockPanel Margin="24,0" VerticalAlignment="Center">
                <TextBlock DockPanel.Dock="Right"
                           Text="Hover screen to capture keyboard"
                           FontSize="11" Foreground="#D1D5DB"
                           IsVisible="{Binding ShowScreenDisplay}"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Status}"
                           FontSize="12" Foreground="#9CA3AF" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

    </Grid>
</Window>
