<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PixelWizard.AvaloniaClient.ViewModels"
        x:Class="PixelWizard.AvaloniaClient.Views.MainWindow"
        Title="{Binding WindowTitle}"
        Icon="/Assets/app-icon.png"
        Width="880" Height="620"
        MinWidth="720" MinHeight="540"
        Background="{StaticResource Brush.App.Bg}"
        FontFamily="{StaticResource Font.Sans}"
        x:DataType="vm:MainViewModel"
        KeyDown="OnKeyDown"
        KeyUp="OnKeyUp">

    <Grid RowDefinitions="*,32">

        <!-- ════ Main layout ════ -->
        <Grid Grid.Row="0" Margin="16" ColumnDefinitions="224,*" ColumnSpacing="16">

            <!-- ══ Sidebar ══ -->
            <Border Grid.Column="0" Background="{StaticResource Brush.Sidebar.Bg}" CornerRadius="12">
                <DockPanel Margin="20" LastChildFill="False">

                    <!-- Logo -->
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <Border Width="30" Height="30" Background="{StaticResource Brush.Primary}"
                                    CornerRadius="8" Margin="0,0,10,0">
                                <TextBlock Text="PW" FontSize="12" FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="PixelWizard"
                                       FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.Text.OnDark}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Connect" FontSize="11"
                                   Foreground="{StaticResource Brush.Text.OnDarkMuted}"
                                   Margin="40,0,0,12"/>
                    </StackPanel>

                    <!-- Footer -->
                    <StackPanel DockPanel.Dock="Bottom" Spacing="8">

                        <!-- Session stats when viewing -->
                        <Border Background="{StaticResource Brush.Sidebar.Surface}" CornerRadius="8"
                                Padding="16,12"
                                IsVisible="{Binding ShowScreenDisplay}">
                            <StackPanel Spacing="0">
                                <TextBlock Text="SESSION" FontSize="9" FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.Neutral.400}"
                                           Margin="0,0,0,10"/>
                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                    <TextBlock Grid.Column="0" Text="FPS"
                                               FontSize="12" Foreground="{StaticResource Brush.Text.OnDarkMuted}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding FpsText}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource Brush.Text.OnDark}"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                    <TextBlock Grid.Column="0" Text="Latency"
                                               FontSize="12" Foreground="{StaticResource Brush.Text.OnDarkMuted}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding LatencyText}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource Brush.Text.OnDark}"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="Down"
                                               FontSize="12" Foreground="{StaticResource Brush.Text.OnDarkMuted}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding BandwidthText}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource Brush.Text.OnDark}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Keyboard badge -->
                        <Border Background="#14532D" CornerRadius="6" Padding="10,7"
                                IsVisible="{Binding KeyboardActive}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse Width="6" Height="6" Fill="#10B981" VerticalAlignment="Center"/>
                                <TextBlock Text="Keyboard captured"
                                           FontSize="11" Foreground="#6EE7B7" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- TLS badge -->
                        <Border Background="{StaticResource Brush.Sidebar.Surface}" CornerRadius="6" Padding="10,7">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse Width="6" Height="6" Fill="#10B981" VerticalAlignment="Center"/>
                                <TextBlock Text="TLS encrypted"
                                           FontSize="11"
                                           Foreground="{StaticResource Brush.Text.OnDarkMuted}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="v0.1 · self-hosted" FontSize="10"
                                   Foreground="{StaticResource Brush.Neutral.500}"/>
                    </StackPanel>

                </DockPanel>
            </Border>

            <!-- ══ Right panel ══ -->
            <Border Grid.Column="1" Background="{StaticResource Brush.Surface}" CornerRadius="12"
                    BoxShadow="0 0 0 1 #E5E7EB, 0 4 16 0 #18000000">
                <Grid>

                    <!-- ─── MODE SELECTION ─── -->
                    <StackPanel IsVisible="{Binding ShowModeSelection}"
                                VerticalAlignment="Center" Margin="40,0">
                        <StackPanel.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                            </Transitions>
                        </StackPanel.Transitions>

                        <TextBlock Text="Get started"
                                   FontSize="26" FontWeight="Bold"
                                   Foreground="{StaticResource Brush.Text.Primary}"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="What would you like to do?"
                                   FontSize="14"
                                   Foreground="{StaticResource Brush.Text.Muted}"
                                   Margin="0,0,0,32"/>

                        <!-- HOST card -->
                        <Button Classes="Card" Margin="0,0,0,12"
                                Command="{Binding GoHostCommand}"
                                IsEnabled="{Binding CanHost}"
                                AutomationProperties.Name="Host this computer">
                            <Grid Margin="20,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="44" Height="44"
                                        Background="{StaticResource Brush.Success.Bg}"
                                        CornerRadius="10" Margin="0,0,16,0"
                                        BorderBrush="#2563EB" BorderThickness="3,0,0,0">
                                    <Path Width="20" Height="20" Stretch="Uniform"
                                          StrokeThickness="1.5" Stroke="#16A34A" Fill="Transparent"
                                          Data="M8.288 15.038a5.25 5.25 0 0 1 7.424 0M5.106 11.856c3.807-3.808 9.98-3.808 13.788 0M1.924 8.674c5.565-5.565 14.587-5.565 20.152 0M12 20.25a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5z"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Host this computer"
                                               FontSize="15" FontWeight="SemiBold"
                                               Foreground="{StaticResource Brush.Text.Primary}"/>
                                    <TextBlock FontSize="12"
                                               Foreground="{StaticResource Brush.Text.Muted}"
                                               Margin="0,4,0,0">
                                        <TextBlock.Text>
                                            <Binding Path="CanHost"
                                                     StringFormat="{}Share your screen — {0:available on this device;host not available on this platform}"/>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="›" FontSize="20"
                                           Foreground="{StaticResource Brush.Neutral.300}"
                                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </Grid>
                        </Button>

                        <!-- VIEWER card -->
                        <Button Classes="Card" Command="{Binding GoViewerCommand}"
                                AutomationProperties.Name="Connect to remote computer">
                            <Grid Margin="20,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="44" Height="44"
                                        Background="#EFF6FF" CornerRadius="10"
                                        Margin="0,0,16,0">
                                    <Path Width="20" Height="20" Stretch="Uniform"
                                          StrokeThickness="1.5" Stroke="#2563EB" Fill="Transparent"
                                          Data="M9 17.25v1.007a3 3 0 0 1-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0 1 15 18.257V17.25m6-12V15a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 15V5.25A2.25 2.25 0 0 1 5.25 3h13.5A2.25 2.25 0 0 1 21 5.25z"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Connect to remote"
                                               FontSize="15" FontWeight="SemiBold"
                                               Foreground="{StaticResource Brush.Text.Primary}"/>
                                    <TextBlock Text="View and control another machine"
                                               FontSize="12"
                                               Foreground="{StaticResource Brush.Text.Muted}"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="›" FontSize="20"
                                           Foreground="{StaticResource Brush.Neutral.300}"
                                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </Grid>
                        </Button>

                    </StackPanel>

                    <!-- ─── VIEWER PANEL ─── -->
                    <ScrollViewer IsVisible="{Binding ShowViewerPanel}"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut"/>
                            </Transitions>
                        </ScrollViewer.Transitions>
                        <StackPanel Margin="32,24" Spacing="0" MaxWidth="520">

                            <DockPanel Margin="0,0,0,24">
                                <Button Classes="Ghost" Content="← Back" Width="80" Height="32"
                                        DockPanel.Dock="Left" Command="{Binding BackCommand}"/>
                                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Connect to Remote"
                                               FontSize="20" FontWeight="Bold"
                                               Foreground="{StaticResource Brush.Text.Primary}"/>
                                    <TextBlock Text="IP address or router connection code"
                                               FontSize="12"
                                               Foreground="{StaticResource Brush.Text.Muted}"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- Loading indicator while connecting -->
                            <ProgressBar IsIndeterminate="True" Height="2"
                                         IsVisible="{Binding IsConnecting}"
                                         Margin="0,0,0,8"/>

                            <!-- Direct IP -->
                            <TextBlock Text="DIRECT IP" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.Text.Muted}"
                                       Margin="0,0,0,10"/>

                            <!-- Recent hosts -->
                            <StackPanel IsVisible="{Binding HasRecentHosts}" Margin="0,0,0,12">
                                <TextBlock Text="Recent" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.Text.Secondary}"
                                           Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding RecentHosts}"
                                          SelectedItem="{Binding SelectedRecentHost}"
                                          HorizontalAlignment="Stretch"
                                          FontSize="13"
                                          IsEnabled="{Binding InputEnabled}"
                                          ToolTip.Tip="Recently connected hosts"
                                          AutomationProperties.Name="Recent hosts"/>
                            </StackPanel>

                            <TextBlock Text="Host IP Address" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.Text.Secondary}"
                                       Margin="0,0,0,4"/>
                            <Grid ColumnDefinitions="*,10,120" Margin="0,0,0,12">
                                <TextBox Grid.Column="0" Text="{Binding HostAddress}"
                                         Watermark="192.168.1.10" IsEnabled="{Binding InputEnabled}"
                                         KeyDown="OnAddressKeyDown"
                                         AutomationProperties.Name="Remote host IP address"/>
                                <Button Grid.Column="2" Classes="Primary" Content="Connect"
                                        Command="{Binding ConnectDirectCommand}"
                                        IsEnabled="{Binding InputEnabled}"
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.Name="Connect via IP address"/>
                            </Grid>

                            <!-- Network discovery -->
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,4"
                                        IsVisible="{Binding !IsConnecting}">
                                <Button Classes="Secondary" Content="Scan network"
                                        IsVisible="{Binding !IsScanning}"
                                        Command="{Binding ScanNetworkCommand}"
                                        AutomationProperties.Name="Scan local network"
                                        ToolTip.Tip="Scan local network for PixelWizard hosts (10 s)"/>
                                <Button Classes="Secondary" Content="Stop scan"
                                        IsVisible="{Binding IsScanning}"
                                        Command="{Binding ScanNetworkCommand}"
                                        AutomationProperties.Name="Stop scanning"/>
                                <TextBlock Text="{Binding DiscoveredHosts.Count, StringFormat='{}{0} found'}"
                                           FontSize="12" Foreground="{StaticResource Brush.Text.Muted}"
                                           VerticalAlignment="Center"
                                           IsVisible="{Binding IsScanning}"/>
                            </StackPanel>

                            <ListBox ItemsSource="{Binding DiscoveredHosts}"
                                     IsVisible="{Binding DiscoveredHosts.Count}"
                                     SelectedItem="{Binding SelectedDiscoveredHost}"
                                     Margin="0,0,0,16" MaxHeight="120"
                                     BorderBrush="{StaticResource Brush.Border}"
                                     BorderThickness="1" CornerRadius="8"
                                     FontSize="13"/>

                            <!-- Divider -->
                            <Grid ColumnDefinitions="*,Auto,*" Margin="0,0,0,28">
                                <Separator Grid.Column="0" VerticalAlignment="Center"
                                           Background="{StaticResource Brush.Border}" Height="1"/>
                                <TextBlock Grid.Column="1" Text="  or via code  "
                                           FontSize="12"
                                           Foreground="{StaticResource Brush.Text.Muted}"
                                           VerticalAlignment="Center"/>
                                <Separator Grid.Column="2" VerticalAlignment="Center"
                                           Background="{StaticResource Brush.Border}" Height="1"/>
                            </Grid>

                            <!-- Router + Code -->
                            <TextBlock Text="VIA ROUTER" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.Text.Muted}"
                                       Margin="0,0,0,10"/>
                            <TextBlock Text="Router Address" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.Text.Secondary}"
                                       Margin="0,0,0,4"/>
                            <TextBox Text="{Binding RouterAddress}"
                                     Watermark="router.example.com:9000"
                                     IsEnabled="{Binding InputEnabled}"
                                     Margin="0,0,0,14"
                                     AutomationProperties.Name="Router address"/>
                            <TextBlock Text="Connection Code" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.Text.Secondary}"
                                       Margin="0,0,0,4"/>
                            <Grid ColumnDefinitions="*,10,120" Margin="0,0,0,20">
                                <TextBox Grid.Column="0" Text="{Binding ConnectionCode}"
                                         Watermark="AB12CD" IsEnabled="{Binding InputEnabled}"
                                         FontSize="18" FontWeight="SemiBold"
                                         KeyDown="OnCodeKeyDown"
                                         AutomationProperties.Name="Connection code"/>
                                <Button Grid.Column="2" Classes="Primary" Content="Connect"
                                        Command="{Binding ConnectViaCodeCommand}"
                                        IsEnabled="{Binding InputEnabled}"
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.Name="Connect via code"/>
                            </Grid>

                            <!-- Advanced expander with TLS -->
                            <Expander Header="Advanced" Margin="0,0,0,16">
                                <CheckBox IsChecked="{Binding UseTls}" Margin="0,8,0,0">
                                    <TextBlock Text="Use TLS (recommended)" FontSize="12"
                                               Foreground="{StaticResource Brush.Text.Muted}"/>
                                </CheckBox>
                            </Expander>

                            <!-- Connecting status -->
                            <Border IsVisible="{Binding IsConnecting}"
                                    Background="#EFF6FF" BorderBrush="#BFDBFE"
                                    BorderThickness="1" CornerRadius="8" Padding="16,12">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Ellipse Width="7" Height="7" Fill="#3B82F6" VerticalAlignment="Center"/>
                                    <TextBlock Text="Connecting…" FontSize="13" Foreground="#1D4ED8"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- ─── HOST PANEL ─── -->
                    <ScrollViewer IsVisible="{Binding ShowHostPanel}"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut"/>
                            </Transitions>
                        </ScrollViewer.Transitions>
                        <StackPanel Margin="32,24" Spacing="0" MaxWidth="520">

                            <DockPanel Margin="0,0,0,24">
                                <Button Classes="Ghost" Content="← Back" Width="80" Height="32"
                                        DockPanel.Dock="Left" Command="{Binding BackCommand}"/>
                                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Host This Computer"
                                               FontSize="20" FontWeight="Bold"
                                               Foreground="{StaticResource Brush.Text.Primary}"/>
                                    <TextBlock Text="Share your screen with an incoming viewer"
                                               FontSize="12"
                                               Foreground="{StaticResource Brush.Text.Muted}"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- Feature 2: Monitor dropdown -->
                            <TextBlock Text="Monitor" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.Text.Secondary}"
                                       Margin="0,0,0,4"/>
                            <ComboBox SelectedIndex="{Binding SelectedMonitorIndex}"
                                      ItemsSource="{Binding AvailableMonitors}"
                                      IsEnabled="{Binding !IsHostRunning}"
                                      Width="300" Height="36" FontSize="12"
                                      Margin="0,0,0,16"
                                      AutomationProperties.Name="Select monitor to share">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <!-- Method toggle -->
                            <Border Background="#F3F4F6" CornerRadius="9" Padding="3"
                                    Margin="0,0,0,20" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <RadioButton Content="Direct" GroupName="HostMethod"
                                                 IsChecked="{Binding ShowDirectHostPanel}"
                                                 Padding="14,7" CornerRadius="7"
                                                 FontSize="13" Cursor="Hand"/>
                                    <RadioButton Content="Via Router" GroupName="HostMethod"
                                                 IsChecked="{Binding UseRouterForHost}"
                                                 Padding="14,7" CornerRadius="7"
                                                 FontSize="13" Cursor="Hand"/>
                                </StackPanel>
                            </Border>

                            <!-- Options row: quality + TLS -->
                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,20">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="Quality" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource Brush.Text.Secondary}"
                                               VerticalAlignment="Center"/>
                                    <ComboBox SelectedIndex="{Binding HostQualityIndex}" Width="148"
                                              Height="36" FontSize="12"
                                              AutomationProperties.Name="Streaming quality">
                                        <ComboBoxItem Content="Low bandwidth"/>
                                        <ComboBoxItem Content="Balanced"/>
                                        <ComboBoxItem Content="High quality"/>
                                        <ComboBoxItem Content="Fast"/>
                                        <ComboBoxItem Content="Localhost"/>
                                    </ComboBox>
                                </StackPanel>
                                <CheckBox Grid.Column="2" IsChecked="{Binding HostTlsEnabled}">
                                    <TextBlock Text="TLS" FontSize="12"
                                               Foreground="{StaticResource Brush.Text.Muted}"/>
                                </CheckBox>
                            </Grid>

                            <!-- Direct port form -->
                            <StackPanel IsVisible="{Binding ShowDirectHostPanel}">
                                <TextBlock Text="Port" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.Text.Secondary}"
                                           Margin="0,0,0,4"/>
                                <Grid ColumnDefinitions="110,10,Auto" Margin="0,0,0,0">
                                    <TextBox Grid.Column="0" Text="{Binding HostPort}"
                                             IsEnabled="{Binding !IsHostRunning}"/>
                                    <Button Grid.Column="2" Classes="Primary"
                                            Content="Start hosting" Width="140"
                                            Command="{Binding StartDirectHostCommand}"
                                            IsEnabled="{Binding !IsHostRunning}"/>
                                </Grid>
                            </StackPanel>

                            <!-- Router form -->
                            <StackPanel IsVisible="{Binding ShowRouterHostPanel}">
                                <TextBlock Text="Router Address" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.Text.Secondary}"
                                           Margin="0,0,0,4"/>
                                <Grid ColumnDefinitions="*,10,Auto">
                                    <TextBox Grid.Column="0" Text="{Binding HostRouterAddress}"
                                             IsEnabled="{Binding !IsHostRunning}"/>
                                    <Button Grid.Column="2" Classes="Primary"
                                            Content="Get connection code" Width="164"
                                            Command="{Binding RegisterHostCommand}"
                                            IsEnabled="{Binding !IsHostRunning}"/>
                                </Grid>
                            </StackPanel>

                            <!-- Connection code hero card -->
                            <Border IsVisible="{Binding ShowCodeCard}"
                                    Background="#EFF6FF" BorderBrush="#BFDBFE"
                                    BorderThickness="1" CornerRadius="10"
                                    Padding="20,16" Margin="0,20,0,0">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="SHARE THIS CODE"
                                                   FontSize="10" FontWeight="SemiBold"
                                                   Foreground="#3B82F6" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding HostConnectionCode}"
                                                   FontSize="32" FontWeight="Bold"
                                                   Foreground="#1E40AF"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="Ghost"
                                            Content="Copy" Width="68" Height="34"
                                            FontSize="12" VerticalAlignment="Center"
                                            Command="{Binding CopyCodeCommand}"/>
                                </Grid>
                            </Border>
                            <TextBlock Text="One-time use · Valid for 30 minutes · Share this code with your viewer"
                                       FontSize="11"
                                       Foreground="{StaticResource Brush.Text.Muted}"
                                       Margin="0,8,0,0"
                                       IsVisible="{Binding ShowCodeCard}"/>

                            <!-- Web viewer hint -->
                            <Border IsVisible="{Binding ShowWebViewer}"
                                    Background="{StaticResource Brush.Success.Bg}" BorderBrush="#A7F3D0"
                                    BorderThickness="1" CornerRadius="8"
                                    Padding="16,8" Margin="0,8,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding WebViewerUrl}"
                                               FontSize="12" Foreground="#065F46"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Status row (no Stop button here — it's in the status bar) -->
                            <Grid ColumnDefinitions="Auto,*" Margin="0,14,0,0">
                                <Ellipse Grid.Column="0" Width="7" Height="7"
                                         Fill="#10B981"
                                         VerticalAlignment="Center" Margin="0,0,8,0"
                                         IsVisible="{Binding IsHostRunning}"/>
                                <Ellipse Grid.Column="0" Width="7" Height="7"
                                         Fill="#D1D5DB"
                                         VerticalAlignment="Center" Margin="0,0,8,0"
                                         IsVisible="{Binding !IsHostRunning}"/>
                                <TextBlock Grid.Column="1" Text="{Binding HostStatus}"
                                           FontSize="12"
                                           Foreground="{StaticResource Brush.Text.Muted}"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Feature 6: Session notes toggle (only while running) -->
                            <Button Classes="Ghost" Content="Session Notes"
                                    Height="30" FontSize="12"
                                    HorizontalAlignment="Left"
                                    Margin="0,12,0,0"
                                    IsVisible="{Binding IsHostRunning}"
                                    Command="{Binding ToggleSessionNotesCommand}"/>

                            <Border IsVisible="{Binding SessionNotesVisible}"
                                    Background="{StaticResource Brush.Warning.Bg}"
                                    BorderBrush="{StaticResource Brush.Warning.Border}"
                                    BorderThickness="1" CornerRadius="8"
                                    Padding="12,10" Margin="0,4,0,0">
                                <TextBox Text="{Binding SessionNotes}"
                                         Watermark="Session notes (saved on disconnect)…"
                                         AcceptsReturn="True"
                                         Height="100"
                                         FontSize="12"
                                         TextWrapping="Wrap"
                                         AutomationProperties.Name="Session notes"/>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- ─── SCREEN DISPLAY ─── -->
                    <Grid IsVisible="{Binding ShowScreenDisplay}"
                          RowDefinitions="48,Auto,*,Auto">
                        <Grid.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut"/>
                            </Transitions>
                        </Grid.Transitions>

                        <!-- Toolbar -->
                        <Border Grid.Row="0" Background="{StaticResource Brush.Toolbar.Bg}"
                                CornerRadius="12,12,0,0" Padding="16,0">
                            <DockPanel VerticalAlignment="Center">
                                <!-- Left: live indicator + stats -->
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Spacing="16">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Ellipse Width="7" Height="7" Fill="#10B981" VerticalAlignment="Center"/>
                                        <TextBlock Text="Live"
                                                   Foreground="{StaticResource Brush.Text.OnDark}"
                                                   FontWeight="SemiBold" FontSize="12"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding FpsText}"
                                               Foreground="{StaticResource Brush.Text.OnDarkMuted}"
                                               FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding LatencyText}"
                                               Foreground="{StaticResource Brush.Text.OnDarkMuted}"
                                               FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding BandwidthText}"
                                               Foreground="{StaticResource Brush.Text.OnDarkMuted}"
                                               FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Right: [Quality] [Clipboard] [Chat] [Zoom ComboBox] [+] [−] [Disconnect] -->
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"
                                            Spacing="4" VerticalAlignment="Center">

                                    <!-- Feature 9: Quality preset ComboBox -->
                                    <ComboBox SelectedIndex="{Binding ViewerQualityIndex}"
                                              Height="28" FontSize="11"
                                              Foreground="#E2E8F0" Background="#1E293B"
                                              Width="84"
                                              VerticalAlignment="Center"
                                              ToolTip.Tip="Stream quality"
                                              AutomationProperties.Name="Stream quality">
                                        <ComboBoxItem Content="Low"/>
                                        <ComboBoxItem Content="Balanced"/>
                                        <ComboBoxItem Content="High"/>
                                        <ComboBoxItem Content="Fast"/>
                                    </ComboBox>

                                    <!-- Feature 1: Clipboard -->
                                    <Button Classes="Toolbar" Content="Clipboard"
                                            Command="{Binding SendClipboardCommand}" Width="70"
                                            ToolTip.Tip="Sync clipboard with host"
                                            AutomationProperties.Name="Sync clipboard with host"/>

                                    <!-- Feature 4: Chat toggle with unread badge -->
                                    <Panel>
                                        <Button Classes="Toolbar" Content="Chat"
                                                Command="{Binding ToggleChatCommand}" Width="44"
                                                ToolTip.Tip="Toggle chat panel"
                                                AutomationProperties.Name="Toggle chat panel"/>
                                        <Border Background="#EF4444" CornerRadius="8"
                                                Padding="4,1"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Margin="0,-4,-4,0"
                                                IsVisible="{Binding HasUnreadChat}">
                                            <TextBlock Text="{Binding UnreadChatCount}"
                                                       FontSize="9" Foreground="White"
                                                       FontWeight="Bold"/>
                                        </Border>
                                    </Panel>

                                    <!-- Zoom ComboBox -->
                                    <ComboBox SelectedIndex="{Binding ZoomPresetIndex}"
                                              Height="28" Width="76" FontSize="11"
                                              Foreground="#E2E8F0" Background="#1E293B"
                                              VerticalAlignment="Center"
                                              ToolTip.Tip="Zoom level"
                                              AutomationProperties.Name="Zoom level">
                                        <ComboBoxItem Content="Fit"/>
                                        <ComboBoxItem Content="50%"/>
                                        <ComboBoxItem Content="75%"/>
                                        <ComboBoxItem Content="100%"/>
                                        <ComboBoxItem Content="150%"/>
                                        <ComboBoxItem Content="200%"/>
                                    </ComboBox>

                                    <!-- Zoom In -->
                                    <Button Classes="Toolbar" Content="+"
                                            Command="{Binding ZoomInCommand}" Width="28"
                                            ToolTip.Tip="Zoom in"
                                            AutomationProperties.Name="Zoom in"/>

                                    <!-- Zoom Out -->
                                    <Button Classes="Toolbar" Content="−"
                                            Command="{Binding ZoomOutCommand}" Width="28"
                                            ToolTip.Tip="Zoom out"
                                            AutomationProperties.Name="Zoom out"/>

                                    <!-- Disconnect -->
                                    <Button Classes="Danger" Content="Disconnect"
                                            Command="{Binding DisconnectCommand}"
                                            Height="28" FontSize="11" Padding="10,0"
                                            ToolTip.Tip="End session and disconnect"
                                            AutomationProperties.Name="Disconnect from session"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Feature 3: No-frames warning banner -->
                        <Border Grid.Row="1"
                                IsVisible="{Binding ShowNoFramesBanner}"
                                Background="{StaticResource Brush.Warning.Bg}"
                                BorderBrush="#F59E0B"
                                BorderThickness="0,0,0,1" Padding="16,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Path Width="16" Height="16" Stretch="Uniform"
                                      StrokeThickness="1.5" Stroke="#D97706" Fill="Transparent"
                                      Data="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"
                                      VerticalAlignment="Center"/>
                                <TextBlock Text="No frames received — check connection"
                                           FontSize="12" Foreground="#92400E"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Screen area -->
                        <Grid Grid.Row="2">
                            <!-- Fit mode -->
                            <Border IsVisible="{Binding IsFitMode}" Background="#020617">
                                <Grid>
                                    <Image Stretch="Uniform"
                                           Source="{Binding RemoteScreen}"
                                           HorizontalAlignment="Stretch"
                                           VerticalAlignment="Stretch"
                                           Cursor="Cross"
                                           PointerPressed="OnScreenPointerPressed"
                                           PointerReleased="OnScreenPointerReleased"
                                           PointerMoved="OnScreenPointerMoved"
                                           PointerEntered="OnScreenPointerEntered"
                                           PointerExited="OnScreenPointerExited"/>
                                    <!-- Empty state -->
                                    <StackPanel IsVisible="{Binding RemoteScreen, Converter={x:Static ObjectConverters.IsNull}}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="Waiting for screen…" FontSize="13"
                                                   Foreground="#475569" HorizontalAlignment="Center"/>
                                        <TextBlock Text="The remote screen will appear here once the host starts streaming."
                                                   FontSize="11" Foreground="#334155"
                                                   TextAlignment="Center" TextWrapping="Wrap"
                                                   MaxWidth="280" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Zoom mode -->
                            <ScrollViewer IsVisible="{Binding !IsFitMode}"
                                          Background="#020617"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto">
                                <Image Source="{Binding RemoteScreen}"
                                       Stretch="None"
                                       Width="{Binding ScaledImageWidth}"
                                       Height="{Binding ScaledImageHeight}"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"
                                       Cursor="Cross"
                                       PointerPressed="OnScreenPointerPressed"
                                       PointerReleased="OnScreenPointerReleased"
                                       PointerMoved="OnScreenPointerMoved"
                                       PointerEntered="OnScreenPointerEntered"
                                       PointerExited="OnScreenPointerExited"/>
                            </ScrollViewer>
                        </Grid>

                        <!-- Feature 4: Chat panel (overlay at bottom) -->
                        <Border Grid.Row="2"
                                IsVisible="{Binding ChatVisible}"
                                Background="#CC0F172A"
                                BorderBrush="#1E293B"
                                BorderThickness="0,1,0,0"
                                MaxHeight="200"
                                VerticalAlignment="Bottom">
                            <Grid RowDefinitions="Auto,*,44">
                                <!-- Chat header with close button -->
                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto"
                                      Margin="12,6,12,4">
                                    <TextBlock Grid.Column="0" Text="Chat"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="#94A3B8" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Classes="Toolbar" Content="✕"
                                            Width="22" Height="22" Padding="0"
                                            Command="{Binding ToggleChatCommand}"
                                            AutomationProperties.Name="Close chat panel"/>
                                </Grid>
                                <!-- Chat messages -->
                                <ScrollViewer Grid.Row="1"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Padding="12,4">
                                    <ItemsControl ItemsSource="{Binding ChatMessages}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Display}"
                                                           FontSize="11"
                                                           Foreground="#CBD5E1"
                                                           TextWrapping="Wrap"
                                                           Margin="0,2"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <!-- Chat input -->
                                <Grid Grid.Row="2" ColumnDefinitions="*,80" Margin="8,4,8,8">
                                    <TextBox Grid.Column="0"
                                             Text="{Binding ChatInput}"
                                             Watermark="Type a message…"
                                             Background="#1E293B"
                                             Foreground="#F1F5F9"
                                             BorderBrush="#334155"
                                             Height="36"
                                             FontSize="12"
                                             Margin="0,0,4,0"
                                             AutomationProperties.Name="Chat message"/>
                                    <Button Grid.Column="1" Classes="Primary"
                                            Content="Send"
                                            Height="36"
                                            Command="{Binding SendChatCommand}"
                                            AutomationProperties.Name="Send chat message"/>
                                </Grid>
                            </Grid>
                        </Border>

                    </Grid>

                </Grid>
            </Border>

        </Grid>

        <!-- ════ Status bar ════ -->
        <Border Grid.Row="1" Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0">
            <DockPanel Margin="24,0" VerticalAlignment="Center">
                <!-- Stop Hosting button — persistent, right side -->
                <Button DockPanel.Dock="Right" Classes="Danger" Content="Stop hosting"
                        Height="24" FontSize="11" Padding="12,0"
                        IsVisible="{Binding IsHostRunning}"
                        Command="{Binding StopHostCommand}"
                        AutomationProperties.Name="Stop hosting session"
                        Margin="0,0,0,0"/>
                <TextBlock DockPanel.Dock="Right"
                           Text="Hover screen to capture keyboard"
                           FontSize="11"
                           Foreground="{StaticResource Brush.Neutral.300}"
                           IsVisible="{Binding ShowScreenDisplay}"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0"/>
                <TextBlock Text="{Binding Status}"
                           FontSize="13"
                           Foreground="{StaticResource Brush.Text.Secondary}"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- ════ First-run onboarding overlay ════ -->
        <Border Grid.Row="0" Grid.RowSpan="2"
                IsVisible="{Binding ShowOnboarding}"
                Background="#CC0F172A">
            <Border Background="{StaticResource Brush.Surface}"
                    CornerRadius="14"
                    BoxShadow="0 8 32 0 #40000000"
                    MaxWidth="460"
                    Margin="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="32,28">
                <StackPanel Spacing="0">

                    <TextBlock Text="Welcome to PixelWizard Connect"
                               FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource Brush.Text.Primary}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="Secure, consent-first remote desktop in three steps."
                               FontSize="13"
                               Foreground="{StaticResource Brush.Text.Muted}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,24"/>

                    <!-- Step 1 -->
                    <Grid ColumnDefinitions="32,*" Margin="0,0,0,16">
                        <Border Grid.Column="0" Width="24" Height="24"
                                Background="{StaticResource Brush.Primary}" CornerRadius="12"
                                VerticalAlignment="Top">
                            <TextBlock Text="1" FontSize="12" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Grid.Column="1" TextWrapping="Wrap"
                                   FontSize="13" Foreground="{StaticResource Brush.Text.Secondary}"
                                   Text="Host a machine — choose Host, then share the connection code or your local IP."/>
                    </Grid>

                    <!-- Step 2 -->
                    <Grid ColumnDefinitions="32,*" Margin="0,0,0,16">
                        <Border Grid.Column="0" Width="24" Height="24"
                                Background="{StaticResource Brush.Primary}" CornerRadius="12"
                                VerticalAlignment="Top">
                            <TextBlock Text="2" FontSize="12" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Grid.Column="1" TextWrapping="Wrap"
                                   FontSize="13" Foreground="{StaticResource Brush.Text.Secondary}"
                                   Text="Connect from another machine — choose Connect, enter the code or scan your network."/>
                    </Grid>

                    <!-- Step 3 -->
                    <Grid ColumnDefinitions="32,*" Margin="0,0,0,28">
                        <Border Grid.Column="0" Width="24" Height="24"
                                Background="{StaticResource Brush.Primary}" CornerRadius="12"
                                VerticalAlignment="Top">
                            <TextBlock Text="3" FontSize="12" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Grid.Column="1" TextWrapping="Wrap"
                                   FontSize="13" Foreground="{StaticResource Brush.Text.Secondary}"
                                   Text="Stay in control — the host approves every session and can stop sharing anytime."/>
                    </Grid>

                    <Button Classes="Primary" Content="Get started"
                            Height="42"
                            HorizontalAlignment="Stretch"
                            Command="{Binding DismissOnboardingCommand}"
                            AutomationProperties.Name="Dismiss onboarding"/>

                </StackPanel>
            </Border>
        </Border>

    </Grid>
</Window>
