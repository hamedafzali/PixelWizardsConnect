<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PixelWizard.AvaloniaClient.ViewModels"
        xmlns:views="using:PixelWizard.AvaloniaClient.Views"
        x:Class="PixelWizard.AvaloniaClient.Views.MainWindow"
        Title="{Binding WindowTitle}"
        Icon="/Assets/app-icon.png"
        Width="880" Height="620"
        MinWidth="720" MinHeight="540"
        Background="{StaticResource Brush.App.Bg}"
        FontFamily="{StaticResource Font.Sans}"
        x:DataType="vm:MainViewModel">

    <Grid RowDefinitions="*,32">

        <!-- ════ Main layout ════ -->
        <Grid Grid.Row="0" Margin="16" ColumnDefinitions="Auto,*">

            <!-- ══ Sidebar (collapsible while viewing) ══ -->
            <views:SidebarView Grid.Column="0" IsVisible="{Binding ShowSidebar}"/>

            <!-- ══ Right panel ══ -->
            <Border Grid.Column="1" Background="{StaticResource Brush.Surface}" CornerRadius="12"
                    BoxShadow="{StaticResource Shadow.Card}">
                <Grid>

                    <!-- ─── MODE SELECTION ─── -->
                    <views:ModeSelectionView IsVisible="{Binding ShowModeSelection}"/>

                    <!-- ─── VIEWER PANEL ─── -->
                    <!-- DataContext is Viewer here, so the shell's own values are read from the parent. -->
                    <views:ViewerConnectView DataContext="{Binding Viewer}"
                                             IsVisible="{Binding $parent.((vm:MainViewModel)DataContext).ShowViewerPanel}"
                                             BackCommand="{Binding $parent.((vm:MainViewModel)DataContext).BackCommand}"/>

                    <!-- ─── HOST PANEL ─── -->
                    <views:HostView DataContext="{Binding Host}"
                                    IsVisible="{Binding $parent.((vm:MainViewModel)DataContext).ShowHostPanel}"
                                    BackCommand="{Binding $parent.((vm:MainViewModel)DataContext).BackCommand}"/>

                    <!-- ─── SCREEN DISPLAY ─── -->
                    <views:LiveScreenView DataContext="{Binding Viewer}"
                                          IsVisible="{Binding $parent.((vm:MainViewModel)DataContext).ShowScreenDisplay}"
                                          Chat="{Binding $parent.((vm:MainViewModel)DataContext).Chat}"
                                          ToggleSidebarCommand="{Binding $parent.((vm:MainViewModel)DataContext).ToggleSidebarCommand}"
                                          PopOutCommand="{Binding $parent.((vm:MainViewModel)DataContext).PopOutScreenCommand}"/>

                    <!-- ─── SCREEN IN ITS OWN WINDOW ─── -->
                    <StackPanel IsVisible="{Binding ShowScreenWindow}"
                                HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="{StaticResource Space.8}">
                        <TextBlock Text="The remote screen is open in its own window"
                                   FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"
                                   Foreground="{StaticResource Brush.Text.Primary}"/>
                        <TextBlock Text="Close that window to bring it back here."
                                   FontSize="12" HorizontalAlignment="Center"
                                   Foreground="{StaticResource Brush.Text.Muted}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                    Spacing="{StaticResource Space.8}" Margin="0,8,0,0">
                            <Button Classes="Secondary" Content="Bring it back" Height="32" Padding="14,0"
                                    Command="{Binding DockScreenCommand}"
                                    AutomationProperties.Name="Bring the remote screen back into this window"/>
                            <Button Classes="Danger" Content="Disconnect" Height="32" Padding="14,0"
                                    Command="{Binding Viewer.DisconnectCommand}"
                                    AutomationProperties.Name="Disconnect from session"/>
                        </StackPanel>
                    </StackPanel>

                </Grid>
            </Border>

        </Grid>

        <!-- ════ Status bar ════ -->
        <views:StatusBar Grid.Row="1"/>

        <!-- ════ First-run onboarding overlay ════ -->
        <views:OnboardingOverlay Grid.Row="0" Grid.RowSpan="2" IsVisible="{Binding ShowOnboarding}"/>

    </Grid>
</Window>
