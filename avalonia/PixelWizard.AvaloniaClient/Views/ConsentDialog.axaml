<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PixelWizard.AvaloniaClient.Views.ConsentDialog"
        Title="Incoming Connection"
        Width="400" Height="240"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        Background="{StaticResource Brush.App.Bg}"
        ShowInTaskbar="False"
        AutomationProperties.Name="Screen is being shared indicator">

    <Border Background="{StaticResource Brush.Surface}"
            CornerRadius="12"
            BoxShadow="0 4 24 0 #28000000"
            Margin="0">
        <Grid Margin="28" RowDefinitions="Auto,*,Auto">

            <!-- Icon + title -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                <Border Width="42" Height="42"
                        Background="#EFF6FF"
                        CornerRadius="10"
                        Margin="0,0,14,0">
                    <Path Width="20" Height="20" Stretch="Uniform"
                          StrokeThickness="1.5" Stroke="#2563EB" Fill="Transparent"
                          Data="M9 17.25v1.007a3 3 0 0 1-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0 1 15 18.257V17.25m6-12V15a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 15V5.25A2.25 2.25 0 0 1 5.25 3h13.5A2.25 2.25 0 0 1 21 5.25z"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Incoming Connection"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.Text.Primary}"/>
                    <TextBlock Text="Someone wants to view this screen"
                               FontSize="12"
                               Foreground="{StaticResource Brush.Text.Muted}"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Detail box -->
            <Border Grid.Row="1"
                    Background="{StaticResource Brush.Surface.Input}"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,12">
                <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="60,*">
                        <TextBlock Grid.Column="0" Text="Time"
                                   FontSize="13"
                                   Foreground="{StaticResource Brush.Text.Muted}"/>
                        <TextBlock Grid.Column="1" x:Name="TimeText"
                                   FontSize="13" FontWeight="Medium"
                                   Foreground="{StaticResource Brush.Text.Primary}"/>
                    </Grid>
                    <Grid ColumnDefinitions="60,*">
                        <TextBlock Grid.Column="0" Text="From"
                                   FontSize="13"
                                   Foreground="{StaticResource Brush.Text.Muted}"/>
                        <TextBlock Grid.Column="1" x:Name="EndpointText"
                                   FontSize="13" FontWeight="Medium"
                                   Foreground="{StaticResource Brush.Text.Primary}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Buttons -->
            <Grid Grid.Row="2" ColumnDefinitions="*,12,*" Margin="0,16,0,0">
                <Button Grid.Column="0"
                        Classes="Secondary"
                        Content="Deny"
                        Height="40"
                        HorizontalAlignment="Stretch"
                        Click="OnDeny"
                        AutomationProperties.Name="Deny incoming connection"/>
                <Button Grid.Column="2"
                        Classes="Primary"
                        Content="Allow"
                        Height="40"
                        HorizontalAlignment="Stretch"
                        Click="OnAllow"
                        AutomationProperties.Name="Allow incoming connection"/>
            </Grid>

        </Grid>
    </Border>
</Window>
