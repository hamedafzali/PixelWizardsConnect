<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PixelWizard.AvaloniaClient.ViewModels"
             xmlns:views="using:PixelWizard.AvaloniaClient.Views"
             x:Class="PixelWizard.AvaloniaClient.Views.HostView"
             x:DataType="vm:HostViewModel">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <ScrollViewer.Transitions>
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut"/>
            </Transitions>
        </ScrollViewer.Transitions>
        <StackPanel Margin="{StaticResource Space.32x24}" Spacing="0" MaxWidth="520">

            <DockPanel Margin="{StaticResource Space.Bottom.24}">
                <Button Classes="Ghost" Content="← Back" Width="80" Height="32"
                        DockPanel.Dock="Left" Command="{Binding $parent[views:HostView].BackCommand}"/>
                <StackPanel Margin="{StaticResource Space.Left.16}" VerticalAlignment="Center">
                    <TextBlock Text="Host This Computer"
                               FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource Brush.Text.Primary}"/>
                    <TextBlock Text="Share your screen with an incoming viewer"
                               FontSize="12"
                               Foreground="{StaticResource Brush.Text.Muted}"
                               Margin="{StaticResource Space.Top.4}"/>
                </StackPanel>
            </DockPanel>

            <!-- Feature 2: Monitor dropdown -->
            <TextBlock Text="Monitor" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource Brush.Text.Secondary}"
                       Margin="{StaticResource Space.Bottom.4}"/>
            <ComboBox SelectedIndex="{Binding SelectedMonitorIndex}"
                      ItemsSource="{Binding AvailableMonitors}"
                      IsEnabled="{Binding !IsHostRunning}"
                      Width="300" Height="36" FontSize="12"
                      Margin="{StaticResource Space.Bottom.16}"
                      AutomationProperties.Name="Select monitor to share">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <!-- Method toggle -->
            <Border Background="{StaticResource Brush.Segmented.Bg}" CornerRadius="9" Padding="3"
                    Margin="{StaticResource Space.Bottom.20}" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <RadioButton Content="Direct" GroupName="HostMethod"
                                 IsChecked="{Binding ShowDirectHostPanel}"
                                 Padding="{StaticResource Space.14x7}" CornerRadius="7"
                                 FontSize="13" Cursor="Hand"/>
                    <RadioButton Content="Via Router" GroupName="HostMethod"
                                 IsChecked="{Binding UseRouterForHost}"
                                 Padding="{StaticResource Space.14x7}" CornerRadius="7"
                                 FontSize="13" Cursor="Hand"/>
                </StackPanel>
            </Border>

            <!-- Options row: quality + TLS -->
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="{StaticResource Space.Bottom.20}">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="{StaticResource Space.10}">
                    <TextBlock Text="Quality" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.Text.Secondary}"
                               VerticalAlignment="Center"/>
                    <ComboBox SelectedIndex="{Binding HostQualityIndex}" Width="148"
                              Height="36" FontSize="12"
                              AutomationProperties.Name="Streaming quality">
                        <ComboBoxItem Content="Low bandwidth"/>
                        <ComboBoxItem Content="Balanced"/>
                        <ComboBoxItem Content="High quality"/>
                        <ComboBoxItem Content="Fast"/>
                        <ComboBoxItem Content="Localhost"/>
                    </ComboBox>
                </StackPanel>
                <CheckBox Grid.Column="2" IsChecked="{Binding HostTlsEnabled}">
                    <TextBlock Text="TLS" FontSize="12"
                               Foreground="{StaticResource Brush.Text.Muted}"/>
                </CheckBox>
            </Grid>

            <!-- Direct port form -->
            <StackPanel IsVisible="{Binding ShowDirectHostPanel}">
                <TextBlock Text="Port" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.Text.Secondary}"
                           Margin="{StaticResource Space.Bottom.4}"/>
                <Grid ColumnDefinitions="110,10,Auto" Margin="0,0,0,0">
                    <TextBox Grid.Column="0" Text="{Binding HostPort}"
                             IsEnabled="{Binding !IsHostRunning}"/>
                    <Button Grid.Column="2" Classes="Primary"
                            Content="Start hosting" Width="140"
                            Command="{Binding StartDirectHostCommand}"
                            IsEnabled="{Binding !IsHostRunning}"/>
                </Grid>
            </StackPanel>

            <!-- Router form -->
            <StackPanel IsVisible="{Binding ShowRouterHostPanel}">
                <TextBlock Text="Router Address" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.Text.Secondary}"
                           Margin="{StaticResource Space.Bottom.4}"/>
                <Grid ColumnDefinitions="*,10,Auto">
                    <TextBox Grid.Column="0" Text="{Binding HostRouterAddress}"
                             IsEnabled="{Binding !IsHostRunning}"/>
                    <Button Grid.Column="2" Classes="Primary"
                            Content="Get connection code" Width="164"
                            Command="{Binding RegisterHostCommand}"
                            IsEnabled="{Binding !IsHostRunning}"/>
                </Grid>
            </StackPanel>

            <!-- Connection code hero card -->
            <Border IsVisible="{Binding ShowCodeCard}"
                    Background="{StaticResource Brush.Info.Bg}" BorderBrush="{StaticResource Brush.Info.Border}"
                    BorderThickness="1" CornerRadius="10"
                    Padding="20,16" Margin="0,20,0,0">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="SHARE THIS CODE"
                                   FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.Info}" Margin="{StaticResource Space.Bottom.4}"/>
                        <TextBlock Text="{Binding HostConnectionCode}"
                                   FontSize="32" FontWeight="Bold"
                                   Foreground="{StaticResource Brush.Info.TextStrong}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Classes="Ghost"
                            Content="Copy" Width="68" Height="34"
                            FontSize="12" VerticalAlignment="Center"
                            Command="{Binding CopyCodeCommand}"/>
                </Grid>
            </Border>
            <TextBlock Text="One-time use · Valid for 30 minutes · Share this code with your viewer"
                       FontSize="11"
                       Foreground="{StaticResource Brush.Text.Muted}"
                       Margin="{StaticResource Space.Top.8}"
                       IsVisible="{Binding ShowCodeCard}"/>

            <!-- Web viewer hint -->
            <Border IsVisible="{Binding ShowWebViewer}"
                    Background="{StaticResource Brush.Success.Bg}" BorderBrush="{StaticResource Brush.Success.Border}"
                    BorderThickness="1" CornerRadius="8"
                    Padding="{StaticResource Space.16x8}" Margin="{StaticResource Space.Top.8}">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.8}">
                    <TextBlock Text="{Binding WebViewerUrl}"
                               FontSize="12" Foreground="{StaticResource Brush.Success.Text}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Status row (no Stop button here — it's in the status bar) -->
            <Grid ColumnDefinitions="Auto,*" Margin="0,14,0,0">
                <Ellipse Grid.Column="0" Width="7" Height="7"
                         Fill="{StaticResource Brush.Indicator.On}"
                         VerticalAlignment="Center" Margin="{StaticResource Space.Right.8}"
                         IsVisible="{Binding IsHostRunning}"/>
                <Ellipse Grid.Column="0" Width="7" Height="7"
                         Fill="{StaticResource Brush.Indicator.Off}"
                         VerticalAlignment="Center" Margin="{StaticResource Space.Right.8}"
                         IsVisible="{Binding !IsHostRunning}"/>
                <TextBlock Grid.Column="1" Text="{Binding HostStatus}"
                           FontSize="12"
                           Foreground="{StaticResource Brush.Text.Muted}"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- Feature 6: Session notes toggle (only while running) -->
            <Button Classes="Ghost" Content="Session Notes"
                    Height="30" FontSize="12"
                    HorizontalAlignment="Left"
                    Margin="0,12,0,0"
                    IsVisible="{Binding IsHostRunning}"
                    Command="{Binding ToggleSessionNotesCommand}"/>

            <Border IsVisible="{Binding SessionNotesVisible}"
                    Background="{StaticResource Brush.Warning.Bg}"
                    BorderBrush="{StaticResource Brush.Warning.Border}"
                    BorderThickness="1" CornerRadius="8"
                    Padding="12,10" Margin="{StaticResource Space.Top.4}">
                <TextBox Text="{Binding SessionNotes}"
                         Watermark="Session notes (saved on disconnect)…"
                         AcceptsReturn="True"
                         Height="100"
                         FontSize="12"
                         TextWrapping="Wrap"
                         AutomationProperties.Name="Session notes"/>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
