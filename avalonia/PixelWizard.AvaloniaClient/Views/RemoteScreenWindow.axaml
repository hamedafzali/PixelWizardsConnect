<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PixelWizard.AvaloniaClient.ViewModels"
        xmlns:views="using:PixelWizard.AvaloniaClient.Views"
        x:Class="PixelWizard.AvaloniaClient.Views.RemoteScreenWindow"
        Title="{Binding WindowTitle}"
        Icon="/Assets/app-icon.png"
        Width="1100" Height="720"
        MinWidth="720" MinHeight="400"
        Background="{StaticResource Brush.App.Bg}"
        FontFamily="{StaticResource Font.Sans}"
        x:DataType="vm:MainViewModel">

    <!-- The remote screen popped out of MainWindow. No sidebar or pop out here; closing the
         window brings the screen back. DataContext is Viewer, so the shell's own values are
         read from the parent. -->
    <views:LiveScreenView DataContext="{Binding Viewer}"
                          Chat="{Binding $parent.((vm:MainViewModel)DataContext).Chat}"/>
</Window>
