<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PixelWizard.AvaloniaClient.Views.ViewingBadgeWindow"
        Title=""
        Width="220" Height="48"
        MinWidth="220" MinHeight="48"
        MaxWidth="220" MaxHeight="48"
        CanResize="False"
        ShowInTaskbar="False"
        SystemDecorations="None"
        Topmost="True"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        AutomationProperties.Name="Screen is being shared indicator">

    <Border Background="#CC1F1F1F" CornerRadius="10" Padding="14,10">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Ellipse Width="9" Height="9" Fill="#EF4444" VerticalAlignment="Center"/>
            <TextBlock Text="Screen is being shared"
                       FontSize="12" FontWeight="SemiBold"
                       Foreground="White"
                       VerticalAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>
