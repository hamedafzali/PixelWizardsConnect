<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <!-- Allows cross-compiling the windows target from macOS -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    On Windows: net9.0-windows is listed first so `dotnet run` (no -f flag) picks it,
    enabling the WINDOWS define and full host support (screen capture + input injection).
    On macOS/Linux: only net9.0 is built, avoiding a broken Windows target on CI/dev machines.
  -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <TargetFrameworks>net9.0-windows;net9.0</TargetFrameworks>
  </PropertyGroup>
  <PropertyGroup Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
    <TargetFrameworks>net9.0</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.0" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.0" />
    <PackageReference Include="Avalonia.ReactiveUI" Version="11.3.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.0" />
    <PackageReference Include="ReactiveUI" Version="20.1.1" />
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PixelWizard.Core\PixelWizard.Core.csproj" />
    <ProjectReference Include="..\..\src\PixelWizard.Transport\PixelWizard.Transport.csproj" />
  </ItemGroup>

  <!-- WindowsHost only wired in for the Windows target -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0-windows'">
    <ProjectReference Include="..\..\src\PixelWizard.WindowsHost\PixelWizard.WindowsHost.csproj" />
  </ItemGroup>

  <!-- LinuxHost wired in for the cross-platform target (Mac + Linux) -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <ProjectReference Include="..\..\src\PixelWizard.LinuxHost\PixelWizard.LinuxHost.csproj" />
  </ItemGroup>

</Project>
