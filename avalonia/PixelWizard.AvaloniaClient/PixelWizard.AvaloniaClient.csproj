<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <!-- Allows cross-compiling the windows target from macOS -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- App identity & metadata -->
    <Product>PixelWizard Connect</Product>
    <Company>PixelWizard</Company>
    <Authors>PixelWizard</Authors>
    <Description>Self-hostable, consent-first remote desktop.</Description>
    <Version>1.0.0</Version>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>

  <!--
    Use a single TargetFramework per OS so `dotnet run` never needs -f and there
    is no ambiguity about which TFM is active.  Single TFM = WINDOWS define is
    always set on Windows = WindowsHostProvider = host mode enabled.
  -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <TargetFramework>net9.0-windows</TargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
    <TargetFramework>net9.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.0" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.0" />
    <PackageReference Include="Avalonia.ReactiveUI" Version="11.3.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.0" />
    <PackageReference Include="ReactiveUI" Version="20.1.1" />
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PixelWizard.Core\PixelWizard.Core.csproj" />
    <ProjectReference Include="..\..\src\PixelWizard.Transport\PixelWizard.Transport.csproj" />
  </ItemGroup>

  <!-- WindowsHost only wired in for the Windows target -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0-windows'">
    <ProjectReference Include="..\..\src\PixelWizard.WindowsHost\PixelWizard.WindowsHost.csproj" />
  </ItemGroup>

  <!-- LinuxHost wired in for the cross-platform target (Mac + Linux) -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <ProjectReference Include="..\..\src\PixelWizard.LinuxHost\PixelWizard.LinuxHost.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PixelWizard.Tests" />
  </ItemGroup>

</Project>
