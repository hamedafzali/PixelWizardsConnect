<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PixelWizard.AvaloniaClient.App"
             RequestedThemeVariant="Light">

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

    <!-- Feature 7: System tray icon -->
    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon ToolTipText="PixelWizard Connect">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Show"/>
                        <NativeMenuItemSeparator/>
                        <NativeMenuItem Header="Quit"/>
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>

</Application>
