<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <FontFamily x:Key="Font.Sans">avares://Avalonia.Fonts.Inter/Assets#Inter</FontFamily>

    <sys:Double x:Key="FontSize.Xs">11</sys:Double>
    <sys:Double x:Key="FontSize.Sm">12</sys:Double>
    <sys:Double x:Key="FontSize.Base">13</sys:Double>
    <sys:Double x:Key="FontSize.Md">15</sys:Double>
    <sys:Double x:Key="FontSize.Lg">18</sys:Double>
    <sys:Double x:Key="FontSize.Xl">24</sys:Double>
    <sys:Double x:Key="FontSize.Code">28</sys:Double>

</ResourceDictionary>
