<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="Brush.Primary"          Color="#2563EB"/>
    <SolidColorBrush x:Key="Brush.Primary.Hover"    Color="#1D4ED8"/>
    <SolidColorBrush x:Key="Brush.Primary.Pressed"  Color="#1E40AF"/>
    <SolidColorBrush x:Key="Brush.Sidebar.Bg"       Color="#0F172A"/>
    <SolidColorBrush x:Key="Brush.Sidebar.Surface"  Color="#1E293B"/>
    <SolidColorBrush x:Key="Brush.App.Bg"           Color="#F8FAFC"/>
    <SolidColorBrush x:Key="Brush.Surface"          Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Surface.Subtle"   Color="#F8FAFC"/>
    <SolidColorBrush x:Key="Brush.Surface.Input"    Color="#F9FAFB"/>
    <SolidColorBrush x:Key="Brush.Border"           Color="#E2E8F0"/>
    <SolidColorBrush x:Key="Brush.Border.Focus"     Color="#2563EB"/>
    <SolidColorBrush x:Key="Brush.Text.Primary"     Color="#0F172A"/>
    <SolidColorBrush x:Key="Brush.Text.Secondary"   Color="#374151"/>
    <SolidColorBrush x:Key="Brush.Text.Muted"       Color="#64748B"/>
    <SolidColorBrush x:Key="Brush.Text.OnDark"      Color="#F1F5F9"/>
    <SolidColorBrush x:Key="Brush.Text.OnDarkMuted" Color="#94A3B8"/>
    <SolidColorBrush x:Key="Brush.Success"          Color="#16A34A"/>
    <SolidColorBrush x:Key="Brush.Success.Bg"       Color="#F0FDF4"/>
    <SolidColorBrush x:Key="Brush.Error"            Color="#DC2626"/>
    <SolidColorBrush x:Key="Brush.Error.Bg"         Color="#FFF1F2"/>
    <SolidColorBrush x:Key="Brush.Error.Border"     Color="#FECACA"/>
    <SolidColorBrush x:Key="Brush.Warning"          Color="#D97706"/>
    <SolidColorBrush x:Key="Brush.Warning.Bg"       Color="#FFFBEB"/>
    <SolidColorBrush x:Key="Brush.Warning.Border"   Color="#FDE68A"/>
    <SolidColorBrush x:Key="Brush.Toolbar.Bg"       Color="#0F172A"/>
    <SolidColorBrush x:Key="Brush.Toolbar.Surface"  Color="#1E293B"/>
    <SolidColorBrush x:Key="Brush.Toolbar.Hover"    Color="#334155"/>
    <SolidColorBrush x:Key="Brush.Chat.Bg"          Color="#0F172A"/>
    <SolidColorBrush x:Key="Brush.Neutral.200"      Color="#E2E8F0"/>
    <SolidColorBrush x:Key="Brush.Neutral.300"      Color="#CBD5E1"/>
    <SolidColorBrush x:Key="Brush.Neutral.400"      Color="#94A3B8"/>
    <SolidColorBrush x:Key="Brush.Neutral.500"      Color="#64748B"/>
    <SolidColorBrush x:Key="Brush.Neutral.600"      Color="#475569"/>

    <!-- Moved from MainWindow.axaml (T13.5), values unchanged -->
    <SolidColorBrush x:Key="Brush.Info"                Color="#3B82F6"/>
    <SolidColorBrush x:Key="Brush.Info.Bg"             Color="#EFF6FF"/>
    <SolidColorBrush x:Key="Brush.Info.Border"         Color="#BFDBFE"/>
    <SolidColorBrush x:Key="Brush.Info.Text"           Color="#1D4ED8"/>
    <SolidColorBrush x:Key="Brush.Info.TextStrong"     Color="#1E40AF"/>
    <SolidColorBrush x:Key="Brush.Success.Border"      Color="#A7F3D0"/>
    <SolidColorBrush x:Key="Brush.Success.Text"        Color="#065F46"/>
    <SolidColorBrush x:Key="Brush.Warning.Strong"      Color="#F59E0B"/>
    <SolidColorBrush x:Key="Brush.Warning.Text"        Color="#92400E"/>
    <SolidColorBrush x:Key="Brush.Indicator.On"        Color="#10B981"/>
    <SolidColorBrush x:Key="Brush.Indicator.Off"       Color="#D1D5DB"/>
    <SolidColorBrush x:Key="Brush.Badge.Keyboard.Bg"   Color="#14532D"/>
    <SolidColorBrush x:Key="Brush.Badge.Keyboard.Text" Color="#6EE7B7"/>
    <SolidColorBrush x:Key="Brush.Badge.Unread"        Color="#EF4444"/>
    <SolidColorBrush x:Key="Brush.Segmented.Bg"        Color="#F3F4F6"/>
    <SolidColorBrush x:Key="Brush.Toolbar.Text"        Color="#E2E8F0"/>
    <SolidColorBrush x:Key="Brush.Screen.Bg"           Color="#020617"/>
    <SolidColorBrush x:Key="Brush.Screen.EmptyText"    Color="#475569"/>
    <SolidColorBrush x:Key="Brush.Screen.EmptySubtext" Color="#334155"/>
    <SolidColorBrush x:Key="Brush.Chat.Overlay"        Color="#CC0F172A"/>
    <SolidColorBrush x:Key="Brush.Chat.Border"         Color="#1E293B"/>
    <SolidColorBrush x:Key="Brush.Chat.Text"           Color="#CBD5E1"/>
    <SolidColorBrush x:Key="Brush.Chat.Input.Bg"       Color="#1E293B"/>
    <SolidColorBrush x:Key="Brush.Chat.Input.Border"   Color="#334155"/>
    <SolidColorBrush x:Key="Brush.Overlay.Scrim"       Color="#CC0F172A"/>

    <BoxShadows x:Key="Shadow.Card">0 0 0 1 #E5E7EB, 0 4 16 0 #18000000</BoxShadows>
    <BoxShadows x:Key="Shadow.Dialog">0 8 32 0 #40000000</BoxShadows>

</ResourceDictionary>
