<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══ Button.Primary ═══════════════════════════════════════════════════ -->
    <Style Selector="Button.Primary">
        <Setter Property="Background"                Value="#2563EB"/>
        <Setter Property="Foreground"                Value="White"/>
        <Setter Property="BorderBrush"               Value="Transparent"/>
        <Setter Property="BorderThickness"           Value="0"/>
        <Setter Property="CornerRadius"              Value="8"/>
        <Setter Property="Height"                    Value="36"/>
        <Setter Property="FontSize"                  Value="13"/>
        <Setter Property="FontWeight"                Value="SemiBold"/>
        <Setter Property="Cursor"                    Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment"   Value="Center"/>
        <Setter Property="Padding"                   Value="16,0"/>
    </Style>
    <Style Selector="Button.Primary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#1D4ED8"/>
    </Style>
    <Style Selector="Button.Primary:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#1E40AF"/>
        <Setter Property="RenderTransform">
            <Setter.Value><ScaleTransform ScaleX="0.98" ScaleY="0.98"/></Setter.Value>
        </Setter>
    </Style>
    <Style Selector="Button.Primary:disabled /template/ ContentPresenter">
        <Setter Property="Opacity" Value="0.45"/>
    </Style>
    <Style Selector="Button.Primary:focus-visible /template/ ContentPresenter">
        <Setter Property="BoxShadow" Value="0 0 0 2 #2563EB, 0 0 0 4 #93C5FD"/>
    </Style>

    <!-- ═══ Button.Secondary ════════════════════════════════════════════════ -->
    <Style Selector="Button.Secondary">
        <Setter Property="Background"                Value="White"/>
        <Setter Property="Foreground"                Value="#374151"/>
        <Setter Property="BorderBrush"               Value="#E2E8F0"/>
        <Setter Property="BorderThickness"           Value="1"/>
        <Setter Property="CornerRadius"              Value="8"/>
        <Setter Property="Height"                    Value="36"/>
        <Setter Property="FontSize"                  Value="13"/>
        <Setter Property="Cursor"                    Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment"   Value="Center"/>
        <Setter Property="Padding"                   Value="16,0"/>
    </Style>
    <Style Selector="Button.Secondary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#F8FAFC"/>
    </Style>
    <Style Selector="Button.Secondary:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#F1F5F9"/>
        <Setter Property="RenderTransform">
            <Setter.Value><ScaleTransform ScaleX="0.98" ScaleY="0.98"/></Setter.Value>
        </Setter>
    </Style>
    <Style Selector="Button.Secondary:disabled /template/ ContentPresenter">
        <Setter Property="Opacity" Value="0.45"/>
    </Style>
    <Style Selector="Button.Secondary:focus-visible">
        <Setter Property="BorderBrush"     Value="#2563EB"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>

    <!-- ═══ Button.Danger ═══════════════════════════════════════════════════ -->
    <Style Selector="Button.Danger">
        <Setter Property="Background"                Value="#FFF1F2"/>
        <Setter Property="Foreground"                Value="#DC2626"/>
        <Setter Property="BorderBrush"               Value="#FECACA"/>
        <Setter Property="BorderThickness"           Value="1"/>
        <Setter Property="CornerRadius"              Value="8"/>
        <Setter Property="FontSize"                  Value="13"/>
        <Setter Property="FontWeight"                Value="SemiBold"/>
        <Setter Property="Cursor"                    Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment"   Value="Center"/>
        <Setter Property="Padding"                   Value="16,0"/>
    </Style>
    <Style Selector="Button.Danger:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#FEE2E2"/>
    </Style>
    <Style Selector="Button.Danger:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#FECACA"/>
        <Setter Property="RenderTransform">
            <Setter.Value><ScaleTransform ScaleX="0.98" ScaleY="0.98"/></Setter.Value>
        </Setter>
    </Style>
    <Style Selector="Button.Danger:disabled /template/ ContentPresenter">
        <Setter Property="Opacity" Value="0.45"/>
    </Style>
    <Style Selector="Button.Danger:focus-visible /template/ ContentPresenter">
        <Setter Property="BoxShadow" Value="0 0 0 2 #DC2626, 0 0 0 4 #FCA5A5"/>
    </Style>

    <!-- ═══ Button.Ghost ════════════════════════════════════════════════════ -->
    <Style Selector="Button.Ghost">
        <Setter Property="Background"                Value="Transparent"/>
        <Setter Property="Foreground"                Value="#374151"/>
        <Setter Property="BorderBrush"               Value="#E2E8F0"/>
        <Setter Property="BorderThickness"           Value="1"/>
        <Setter Property="CornerRadius"              Value="8"/>
        <Setter Property="FontSize"                  Value="13"/>
        <Setter Property="Cursor"                    Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment"   Value="Center"/>
        <Setter Property="Padding"                   Value="16,0"/>
    </Style>
    <Style Selector="Button.Ghost:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#F8FAFC"/>
    </Style>
    <Style Selector="Button.Ghost:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#F1F5F9"/>
    </Style>
    <Style Selector="Button.Ghost:disabled /template/ ContentPresenter">
        <Setter Property="Opacity" Value="0.45"/>
    </Style>
    <Style Selector="Button.Ghost:focus-visible">
        <Setter Property="BorderBrush"     Value="#2563EB"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>

    <!-- ═══ Button.Toolbar ══════════════════════════════════════════════════ -->
    <Style Selector="Button.Toolbar">
        <Setter Property="Background"                Value="#1E293B"/>
        <Setter Property="Foreground"                Value="#E2E8F0"/>
        <Setter Property="BorderBrush"               Value="Transparent"/>
        <Setter Property="BorderThickness"           Value="0"/>
        <Setter Property="CornerRadius"              Value="6"/>
        <Setter Property="Height"                    Value="28"/>
        <Setter Property="FontSize"                  Value="11"/>
        <Setter Property="Padding"                   Value="10,0"/>
        <Setter Property="Cursor"                    Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment"   Value="Center"/>
    </Style>
    <Style Selector="Button.Toolbar:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#334155"/>
    </Style>
    <Style Selector="Button.Toolbar:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#475569"/>
        <Setter Property="RenderTransform">
            <Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Setter.Value>
        </Setter>
    </Style>
    <Style Selector="Button.Toolbar:disabled /template/ ContentPresenter">
        <Setter Property="Opacity" Value="0.4"/>
    </Style>
    <Style Selector="Button.Toolbar:focus-visible">
        <Setter Property="BorderBrush"     Value="#3B82F6"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- ═══ Button.Card ═════════════════════════════════════════════════════ -->
    <Style Selector="Button.Card">
        <Setter Property="Background"                Value="White"/>
        <Setter Property="Foreground"                Value="#0F172A"/>
        <Setter Property="BorderBrush"               Value="#E2E8F0"/>
        <Setter Property="BorderThickness"           Value="1"/>
        <Setter Property="CornerRadius"              Value="12"/>
        <Setter Property="Padding"                   Value="0"/>
        <Setter Property="Cursor"                    Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment"   Value="Stretch"/>
        <Setter Property="HorizontalAlignment"        Value="Stretch"/>
    </Style>
    <Style Selector="Button.Card:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#FAFBFF"/>
        <Setter Property="BoxShadow"  Value="0 2 8 0 #0D000000"/>
    </Style>
    <Style Selector="Button.Card:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#F1F5F9"/>
        <Setter Property="RenderTransform">
            <Setter.Value><ScaleTransform ScaleX="0.99" ScaleY="0.99"/></Setter.Value>
        </Setter>
    </Style>
    <Style Selector="Button.Card:focus-visible">
        <Setter Property="BorderBrush"     Value="#2563EB"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>

</Styles>
